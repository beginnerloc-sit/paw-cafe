/* Paw Café UI. Palette: cream #FFF8EE, ink #4A3328, pink #FF8FAB, mint #7FD1AE, gold #FFC94A, sky #9CC9F0 */
.root { flex-grow: 1; -unity-font: resource("Fonts/Fredoka-SemiBold"); color: rgb(74, 51, 40); }
.layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hidden { display: none; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.top { flex-direction: row; align-items: center; padding: 12px 12px 0 12px; }
.pill { flex-direction: row; align-items: center; background-color: rgb(255, 250, 243); border-radius: 30px; padding: 4px 16px 4px 4px; margin-right: 7px; border-width: 2px; border-bottom-width: 5px; border-color: rgba(214, 180, 150, 0.9); }
.pill-ico { width: 46px; height: 46px; border-radius: 23px; background-color: rgb(255, 225, 184); margin-right: 8px; -unity-background-scale-mode: scale-to-fit; -unity-text-align: middle-center; font-size: 22px; color: rgb(197, 106, 42); }
.pill-val { font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); }
.lvl { width: 72px; height: 72px; border-radius: 36px; background-color: rgb(255, 143, 171); margin-right: 8px; align-items: center; justify-content: center; border-width: 3px; border-bottom-width: 6px; border-color: rgb(224, 104, 138); }
.lvl-num { color: white; font-size: 32px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-align: middle-center; margin-bottom: 8px; }
.lvl-bar { position: absolute; left: 10px; right: 10px; bottom: 9px; height: 7px; border-radius: 4px; background-color: rgba(255,255,255,0.4); }
.lvl-fill { height: 7px; border-radius: 4px; background-color: white; width: 0; }
.ibtn { width: 64px; height: 64px; border-radius: 32px; background-color: rgb(255, 250, 243); border-width: 2px; border-bottom-width: 5px; border-color: rgba(214, 180, 150, 0.9); margin: 0 0 0 8px; padding: 12px; -unity-background-scale-mode: scale-to-fit; }

/* tabs */
.tabs { position: absolute; left: 12px; right: 12px; bottom: 14px; flex-direction: row; background-color: rgb(255, 250, 243); border-radius: 40px; padding: 10px 8px; border-width: 2px; border-bottom-width: 7px; border-color: rgba(214, 180, 150, 0.9); }
.tab { flex-grow: 1; flex-basis: 0; height: 96px; border-radius: 30px; margin: 0 3px; align-items: center; justify-content: center; background-color: rgba(0,0,0,0); border-width: 0; padding: 0; transition-duration: 0.15s; transition-property: translate, scale; }
.tab-ico { width: 50px; height: 50px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(170, 135, 112); }
.tab-lbl { font-size: 24px; color: rgb(160, 125, 102); margin-top: 2px; padding: 0; }
.tab.on { background-color: rgb(255, 226, 235); border-width: 2px; border-bottom-width: 6px; border-color: rgb(255, 143, 171); translate: 0 -12px; }
.tab.on .tab-lbl { color: rgb(214, 82, 122); -unity-font: resource("Fonts/Fredoka-Bold"); }
.tab.on .tab-ico { -unity-background-image-tint-color: rgb(255, 105, 150); scale: 1.12 1.12; }
.badge { position: absolute; right: 8px; top: 2px; min-width: 26px; height: 26px; border-radius: 13px; background-color: rgb(255, 99, 99); color: white; font-size: 20px; -unity-text-align: middle-center; padding: 0 6px; -unity-font: resource("Fonts/Fredoka-Bold"); border-width: 2px; border-color: white; }

/* sheets */
.sheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 62%; background-color: rgb(255, 248, 238); border-top-left-radius: 36px; border-top-right-radius: 36px; padding: 20px 18px 150px 18px; border-top-width: 4px; border-color: rgba(214, 180, 150, 0.6); }
.sheet-title { font-size: 32px; -unity-font: resource("Fonts/Fredoka-Bold"); margin-bottom: 8px; }
.sheet-sub { font-size: 26px; color: rgb(140, 110, 90); margin-bottom: 10px; white-space: normal; }
.chips { flex-direction: row; margin-bottom: 10px; flex-wrap: wrap; }
.chip { padding: 10px 18px; border-radius: 18px; background-color: white; margin: 0 8px 6px 0; font-size: 26px; border-width: 0; border-bottom-width: 3px; border-color: rgba(150,105,70,0.2); }
.chip.on { background-color: rgb(127, 209, 174); color: white; -unity-font: resource("Fonts/Fredoka-Bold"); }
.grid { flex-direction: row; flex-wrap: wrap; }
.card { width: 31%; margin: 0 1% 12px 1%; border-radius: 22px; background-color: white; align-items: center; padding: 10px 6px 12px 6px;
        border-bottom-width: 4px; border-color: rgba(150, 105, 70, 0.15); }
.card-img { width: 110px; height: 110px; -unity-background-scale-mode: scale-to-fit; border-radius: 16px; }
.card-name { font-size: 26px; -unity-text-align: middle-center; white-space: normal; -unity-font: resource("Fonts/Fredoka-Bold"); margin-top: 4px; }
.card-sub { font-size: 22px; -unity-text-align: middle-center; white-space: normal; color: rgb(140, 110, 90); }
.card.locked { opacity: 0.75; }
.btn { height: 64px; padding: 0 22px; border-radius: 20px; background-color: rgb(255, 143, 171); color: white; font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold");
       border-width: 0; border-bottom-width: 5px; border-color: rgb(224, 104, 138); margin: 6px 4px; }
.btn.mint { background-color: rgb(127, 209, 174); border-color: rgb(79, 174, 137); }
.btn.gold { background-color: rgb(255, 201, 74); border-color: rgb(215, 160, 40); color: rgb(110, 70, 10); }
.btn.ghost { background-color: white; color: rgb(74, 51, 40); border-color: rgb(225, 205, 185); }
.btn.small { height: 56px; font-size: 26px; padding: 0 14px; border-radius: 16px; }
.btn:active { translate: 0 3px; border-bottom-width: 2px; }
.btn.off { opacity: 0.45; }
.listrow { flex-direction: row; align-items: center; background-color: white; border-radius: 20px; padding: 10px; margin-bottom: 10px;
           border-bottom-width: 4px; border-color: rgba(150,105,70,0.12); }
.portrait { width: 96px; height: 96px; border-radius: 48px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-to-fit; margin-right: 12px; }
.name { font-size: 25px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.small { font-size: 22px; color: rgb(140, 110, 90); white-space: normal; }
.hearts { flex-direction: row; margin-top: 3px; }
.heart { width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit; margin-right: 2px; }
.photo { width: 31%; height: 180px; margin: 0 1% 12px 1%; border-radius: 14px; background-color: white; border-width: 6px; border-bottom-width: 22px; border-color: white;
         -unity-background-scale-mode: scale-and-crop; }

/* world bubbles */
.wb { position: absolute; width: 64px; height: 64px; border-radius: 32px; background-color: white; align-items: center; justify-content: center;
      border-bottom-width: 4px; border-color: rgba(150,105,70,0.25); translate: -50% -100%; }
.wb-ico { width: 38px; height: 38px; -unity-background-scale-mode: scale-to-fit; }
.wb-txt { font-size: 23px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(197, 106, 42); }
.wb-badge { display: none; }
/* photo request = a little polaroid of the wanted cat */
.wb.photo { background-color: white; width: auto; height: auto; min-width: 104px; border-radius: 10px; padding: 7px 7px 5px 7px;
            border-width: 3px; border-bottom-width: 5px; border-color: rgb(255, 143, 171); rotate: -3deg; }
.wb.photo .wb-ico { width: 88px; height: 88px; border-radius: 6px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-and-crop; }
.wb.photo.anycat .wb-ico { -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 143, 171); }
.wb.photo .wb-txt { font-size: 20px; color: rgb(214, 92, 128); margin-top: 3px; -unity-text-align: middle-center; }
.wb.photo .wb-badge { display: flex; position: absolute; right: -14px; top: -14px; width: 38px; height: 38px; border-radius: 19px;
            background-color: rgb(255, 143, 171); border-width: 3px; border-color: white; -unity-background-scale-mode: scale-to-fit;
            -unity-background-image-tint-color: white; }
.wb.coins { background-color: rgb(255, 230, 150); width: auto; height: 56px; padding: 0 16px 0 8px; flex-direction: row; border-width: 2px; border-bottom-width: 5px; border-color: rgb(215, 160, 40); border-radius: 28px; }
.wb.paw { background-color: rgb(156, 201, 240); border-color: rgb(110,160,210); }
.wb.paw .wb-ico { -unity-background-image-tint-color: white; }
.wb.lock { width: auto; padding: 0 14px; height: 48px; background-color: rgba(74,51,40,0.88); border-color: rgba(0,0,0,0.3); }
.wb.lock .wb-txt { color: white; font-size: 22px; }
.float { position: absolute; font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(255, 201, 74); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(140, 90, 20);
         translate: -50% -100%; }

.wb.coins .wb-ico { width: 38px; height: 38px; margin-right: 6px; }
.wb.coins .wb-txt { font-size: 28px; color: rgb(140, 84, 20); }
.wb.order { width: 76px; height: 76px; border-radius: 38px; border-width: 2px; border-bottom-width: 5px; border-color: rgba(214, 180, 150, 0.9); }
.wb.order .wb-ico { width: 54px; height: 54px; }
.lockpill { flex-direction: row; align-items: center; align-self: center; background-color: rgb(74, 51, 40); border-radius: 16px; padding: 4px 12px 4px 8px; margin: 6px 0 4px 0; }
.lockpill-ico { width: 22px; height: 22px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: white; margin-right: 6px; }
.lockpill-txt { color: white; font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.card.locked { opacity: 0.75; }
.card.locked .card-img { -unity-background-image-tint-color: rgba(255, 255, 255, 0.45); }
.btn.wide { width: 80%; }

/* toast / modal */
.toast { position: absolute; left: 0; right: 0; top: 196px; align-items: center; opacity: 0; transition-duration: 0.25s; transition-property: opacity, translate; translate: 0 -10px; }
.toast.on { opacity: 1; translate: 0 0; }
.toast-box { background-color: rgba(74, 51, 40, 0.92); border-radius: 18px; padding: 10px 20px; max-width: 90%; }
.toast-text { color: white; font-size: 25px; -unity-text-align: middle-center; white-space: normal; }
.scrim { background-color: rgba(40, 25, 20, 0.45); align-items: center; justify-content: center; }
.modal { width: 86%; background-color: rgb(255, 248, 238); border-radius: 32px; padding: 26px 24px; align-items: center; border-width: 2px; border-bottom-width: 7px; border-color: rgba(214, 180, 150, 0.9); transition-property: scale, opacity; transition-duration: 0.22s, 0.15s; transition-timing-function: ease-out-back, ease-out; }
.modal.modal-in { scale: 0.86 0.86; opacity: 0; }
.modal-title { font-size: 32px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-align: middle-center; white-space: normal; margin-bottom: 6px; }
.modal-text { font-size: 25px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 12px; color: rgb(110, 80, 60); }
.big-portrait { width: 220px; height: 220px; -unity-background-scale-mode: scale-to-fit; margin: 6px; }
.polaroid { width: 300px; height: 375px; background-color: white; border-width: 10px; border-bottom-width: 50px; border-color: white; -unity-background-scale-mode: scale-and-crop;
            rotate: -2deg; margin-bottom: 8px; }
.stars { flex-direction: row; justify-content: center; margin: 4px 0 8px 0; }
.star { width: 34px; height: 34px; -unity-background-scale-mode: scale-to-fit; margin: 0 3px; }
.star.off { -unity-background-image-tint-color: rgba(0,0,0,0.15); }
.step { flex-direction: row; align-items: center; width: 100%; background-color: white; border-radius: 18px; padding: 8px 12px; margin-bottom: 8px; }
.step-dot { width: 30px; height: 30px; border-radius: 15px; background-color: rgb(230, 220, 205); margin-right: 10px; color: white; -unity-text-align: middle-center; -unity-font: resource("Fonts/Fredoka-Bold"); }
.step.done .step-dot { background-color: rgb(127, 209, 174); }

/* viewfinder */
.vf { }
.vf-frame { position: absolute; left: 6%; right: 6%; top: 17%; bottom: 24%; border-width: 3px; border-color: rgba(255,255,255,0.85); border-radius: 28px; }
.vf-top { position: absolute; left: 16px; right: 16px; top: 80px; align-items: center; }
.vf-req { background-color: rgba(255, 143, 171, 0.95); border-radius: 18px; padding: 8px 16px; margin-bottom: 6px; }
.vf-req-pic { width: 46px; height: 46px; border-radius: 8px; background-color: white; margin-right: 10px; -unity-background-scale-mode: scale-and-crop; border-width: 2px; border-color: white; }
.vf-req-text { color: white; font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-align: middle-left; white-space: normal; flex-shrink: 1; }
.vf-name { background-color: rgba(74,51,40,0.85); border-radius: 20px; padding: 8px 20px; color: white; font-size: 28px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.vf-bottom { position: absolute; left: 0; right: 0; bottom: 40px; flex-direction: row; justify-content: center; align-items: center; }
.shutter { width: 110px; height: 110px; border-radius: 55px; background-color: white; border-width: 8px; border-color: rgb(255, 143, 171); margin: 0 30px; }
.shutter:active { scale: 0.92 0.92; }
.vf .star { width: 44px; height: 44px; margin: 0 4px; }
.vf-bottom .ibtn { width: 76px; height: 76px; border-radius: 38px; padding: 16px; }
.flash { background-color: white; opacity: 0; transition-duration: 0.35s; transition-property: opacity; }
.flash.on { opacity: 0.9; transition-duration: 0s; }

.coach { position: absolute; left: 16px; right: 16px; top: 100px; align-items: center; }
.coach-box { flex-direction: row; align-items: center; background-color: rgba(255, 250, 243, 0.97); border-radius: 22px; padding: 10px 16px; border-width: 2px; border-bottom-width: 5px; border-color: rgb(255, 170, 120); max-width: 100%; }
.coach-ico { width: 40px; height: 40px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.coach-text { color: rgb(74, 51, 40); font-size: 26px; white-space: normal; flex-shrink: 1; }

/* ---- touch states ----------------------------------------------------------------------------------------
   Unity's default runtime theme greys out .unity-button on :hover/:focus. On a phone :hover "sticks" after a tap,
   so buttons turned grey. Re-state each look for those states and give a gentle press feedback instead. */
.unity-button { -unity-text-align: middle-center; }
.root .btn:hover, .root .btn:focus { background-color: rgb(255, 143, 171); border-color: rgb(224, 104, 138); color: white; }
.root .btn.mint:hover, .root .btn.mint:focus { background-color: rgb(127, 209, 174); border-color: rgb(79, 174, 137); color: white; }
.root .btn.gold:hover, .root .btn.gold:focus { background-color: rgb(255, 201, 74); border-color: rgb(215, 160, 40); color: rgb(110, 70, 10); }
.root .btn.ghost:hover, .root .btn.ghost:focus { background-color: white; border-color: rgb(225, 205, 185); color: rgb(74, 51, 40); }
.root .btn:active { translate: 0 3px; border-bottom-width: 2px; }
.root .ibtn:hover, .root .ibtn:focus { background-color: rgb(255, 250, 243); border-color: rgba(214, 180, 150, 0.9); }
.root .ibtn:active { scale: 0.92 0.92; }
.root .tab:hover, .root .tab:focus { background-color: rgba(255, 226, 235, 0); border-color: rgba(255, 143, 171, 0); }
.root .tab.on:hover, .root .tab.on:focus { background-color: rgb(255, 226, 235); border-color: rgb(255, 143, 171); }
.root .tab:active { scale: 0.94 0.94; }
.root .chip:hover, .root .chip:focus { background-color: white; border-color: rgba(150, 105, 70, 0.2); color: rgb(74, 51, 40); }
.root .chip.on:hover, .root .chip.on:focus { background-color: rgb(127, 209, 174); color: white; }
.root .shutter:hover, .root .shutter:focus { background-color: white; border-color: rgb(255, 143, 171); }

/* ---- cats: cards + profile ------------------------------------------------------------------------------- */
.catgrid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.catcard { width: 48.6%; flex-direction: column; align-items: center; background-color: white; border-radius: 26px; padding: 14px 10px 14px 10px;
           margin: 0 0 12px 0; border-width: 2px; border-bottom-width: 6px; border-color: rgb(232, 218, 204); white-space: normal; }
.root .catcard:hover, .root .catcard:focus { background-color: white; border-color: rgb(232, 218, 204); }
.root .catcard:active { scale: 0.97 0.97; }
.cat-ring { width: 124px; height: 124px; border-radius: 62px; background-color: rgb(255, 236, 222); border-width: 5px; border-color: rgb(205, 190, 175);
            align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
.cat-ring.big { width: 150px; height: 150px; border-radius: 75px; margin-right: 16px; }
.cat-pic { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.rarity-chip { position: absolute; left: 10px; top: 10px; font-size: 20px; color: white; -unity-font: resource("Fonts/Fredoka-Bold");
               background-color: rgb(175, 155, 135); border-radius: 12px; padding: 3px 10px; }
.cat-head .rarity-chip { position: relative; left: 0; top: 0; align-self: flex-start; margin-bottom: 4px; }
.catcard-name { font-size: 29px; -unity-font: resource("Fonts/Fredoka-Bold"); margin-top: 8px; -unity-text-align: middle-center; }
.catcard-sub { font-size: 20px; color: rgb(150, 115, 95); -unity-text-align: middle-center; white-space: normal; }
.catcard .hearts { justify-content: center; margin: 6px 0 6px 0; }
.catcard-status { font-size: 20px; color: rgb(60, 140, 108); background-color: rgb(222, 245, 235); border-radius: 12px; padding: 3px 12px; align-self: center; }
.cat-head .catcard-status { align-self: flex-start; margin-top: 6px; }
.catcard-status.off { color: rgb(170, 110, 60); background-color: rgb(255, 236, 210); }
.heart { width: 24px; height: 24px; }
.heart.off { -unity-background-image-tint-color: rgba(120, 90, 70, 0.18); }
/* rarity colours */
.r-uncommon .cat-ring, .catcard.r-uncommon { border-color: rgb(127, 209, 174); }
.r-uncommon .rarity-chip { background-color: rgb(79, 174, 137); }
.r-rare .cat-ring, .catcard.r-rare { border-color: rgb(120, 175, 240); }
.r-rare .rarity-chip { background-color: rgb(84, 140, 220); }
.r-legendary .cat-ring, .catcard.r-legendary { border-color: rgb(255, 196, 70); }
.r-legendary .rarity-chip { background-color: rgb(230, 160, 30); }
.root .catcard.r-uncommon:hover { border-color: rgb(127, 209, 174); }
.root .catcard.r-rare:hover { border-color: rgb(120, 175, 240); }
.root .catcard.r-legendary:hover { border-color: rgb(255, 196, 70); }
/* profile */
.modal.catmodal { width: 92%; align-items: stretch; padding: 22px 20px 18px 20px; }
.cat-head { flex-direction: row; align-items: center; margin-bottom: 12px; }
.cat-name { font-size: 39px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.cat-sub { font-size: 23px; color: rgb(150, 115, 95); white-space: normal; }
.cat-box { background-color: white; border-radius: 22px; padding: 12px 16px 14px 16px; margin-bottom: 10px; border-bottom-width: 4px; border-color: rgb(238, 226, 214); }
.cat-label { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.cat-hint { font-size: 20px; color: rgb(150, 115, 95); white-space: normal; margin-top: 6px; }
.cat-count { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(214, 82, 122); }
.charm-pill { font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(214, 82, 122); background-color: rgb(255, 228, 236); border-radius: 14px; padding: 4px 12px; }
.stat-row { flex-direction: row; align-items: center; margin-top: 9px; }
.stat-name { width: 122px; font-size: 23px; color: rgb(110, 80, 60); }
.stat-track { flex-grow: 1; height: 16px; border-radius: 8px; background-color: rgb(244, 235, 226); overflow: hidden; }
.stat-fill { height: 100%; border-radius: 8px; }
.stat-fill.c1 { background-color: rgb(255, 143, 171); }
.stat-fill.c2 { background-color: rgb(120, 175, 240); }
.stat-fill.c3 { background-color: rgb(127, 209, 174); }
.stat-fill.c4 { background-color: rgb(186, 160, 230); }
.stat-fill.c5 { background-color: rgb(255, 190, 90); }
.pose-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-top: 10px; }
.pose { width: 31.5%; margin-bottom: 10px; align-items: center; }
.pose-pic { width: 100%; height: 112px; border-radius: 14px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-and-crop;
            border-width: 3px; border-color: white; align-items: center; justify-content: center; }
.pose-pic.empty { background-color: rgb(244, 235, 226); border-color: rgb(244, 235, 226); }
.pose-q { font-size: 40px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgba(150, 120, 100, 0.45); }
.pose-stars { flex-direction: row; position: absolute; top: 88px; background-color: rgba(255, 255, 255, 0.92); border-radius: 10px; padding: 2px 5px; }
.star.tiny { width: 16px; height: 16px; margin: 0 1px; }
.pose-name { font-size: 20px; color: rgb(110, 80, 60); margin-top: 3px; }
.card { }
