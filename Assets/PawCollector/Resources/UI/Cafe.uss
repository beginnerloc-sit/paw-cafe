/* Paw Café UI. Palette: cream #FFF8EE, ink #4A3328, pink #FF8FAB, mint #7FD1AE, gold #FFC94A, sky #9CC9F0 */
.root { flex-grow: 1; -unity-font: resource("Fonts/Fredoka-SemiBold"); color: rgb(74, 51, 40); }
.layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hidden { display: none; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.top { flex-direction: row; align-items: center; padding: 12px 12px 0 12px; }
.pill { flex-direction: row; align-items: center; background-color: rgb(255, 250, 243); border-radius: 30px; padding: 4px 16px 4px 4px; margin-right: 7px; border-width: 2px; border-bottom-width: 5px; border-color: rgba(214, 180, 150, 0.9); }
.pill-ico { width: 46px; height: 46px; border-radius: 23px; background-color: rgb(255, 225, 184); margin-right: 8px; -unity-background-scale-mode: scale-to-fit; -unity-text-align: middle-center; font-size: 22px; color: rgb(197, 106, 42); }
.pill-val { font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); }
.lvl { width: 72px; height: 72px; border-radius: 36px; background-color: rgb(255, 143, 171); margin-right: 8px; align-items: center; justify-content: center; border-width: 3px; border-bottom-width: 6px; border-color: rgb(224, 104, 138); }
.lvl-num { color: white; font-size: 32px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-align: middle-center; margin-bottom: 8px; }
.lvl-bar { position: absolute; left: 10px; right: 10px; bottom: 9px; height: 7px; border-radius: 4px; background-color: rgba(255,255,255,0.4); }
.lvl-fill { height: 7px; border-radius: 4px; background-color: white; width: 0; }
.ibtn { width: 64px; height: 64px; border-radius: 32px; background-color: rgb(255, 250, 243); border-width: 2px; border-bottom-width: 5px; border-color: rgba(214, 180, 150, 0.9); margin: 0 0 0 8px; padding: 12px; -unity-background-scale-mode: scale-to-fit; }

/* tabs */
.tabs { position: absolute; left: 12px; right: 12px; bottom: 14px; flex-direction: row; background-color: rgb(255, 250, 243); border-radius: 40px; padding: 10px 8px; border-width: 2px; border-bottom-width: 7px; border-color: rgba(214, 180, 150, 0.9); }
.tab { flex-grow: 1; flex-basis: 0; height: 96px; border-radius: 30px; margin: 0 3px; align-items: center; justify-content: center; background-color: rgba(0,0,0,0); border-width: 0; padding: 0; transition-duration: 0.15s; transition-property: translate, scale; }
.tab-ico { width: 50px; height: 50px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(170, 135, 112); }
.tab-lbl { font-size: 24px; color: rgb(160, 125, 102); margin-top: 2px; padding: 0; }
.tab.on { background-color: rgb(255, 226, 235); border-width: 2px; border-bottom-width: 6px; border-color: rgb(255, 143, 171); translate: 0 -12px; }
.tab.on .tab-lbl { color: rgb(214, 82, 122); -unity-font: resource("Fonts/Fredoka-Bold"); }
.tab.on .tab-ico { -unity-background-image-tint-color: rgb(255, 105, 150); scale: 1.12 1.12; }
.badge { position: absolute; right: 8px; top: 2px; min-width: 26px; height: 26px; border-radius: 13px; background-color: rgb(255, 99, 99); color: white; font-size: 20px; -unity-text-align: middle-center; padding: 0 6px; -unity-font: resource("Fonts/Fredoka-Bold"); border-width: 2px; border-color: white; }

/* sheets */
.sheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 62%; background-color: rgb(255, 248, 238); border-top-left-radius: 36px; border-top-right-radius: 36px; padding: 20px 18px 150px 18px; border-top-width: 4px; border-color: rgba(214, 180, 150, 0.6); }
.sheet-title { font-size: 32px; -unity-font: resource("Fonts/Fredoka-Bold"); margin-bottom: 8px; }
.sheet-sub { font-size: 26px; color: rgb(140, 110, 90); margin-bottom: 10px; white-space: normal; }
.chips { flex-direction: row; margin-bottom: 10px; flex-wrap: wrap; }
.chip { padding: 10px 18px; border-radius: 18px; background-color: white; margin: 0 8px 6px 0; font-size: 26px; border-width: 0; border-bottom-width: 3px; border-color: rgba(150,105,70,0.2); }
.chip.on { background-color: rgb(127, 209, 174); color: white; -unity-font: resource("Fonts/Fredoka-Bold"); }
.grid { flex-direction: row; flex-wrap: wrap; }
.card { width: 31%; margin: 0 1% 12px 1%; border-radius: 22px; background-color: white; align-items: center; padding: 10px 6px 12px 6px;
        border-bottom-width: 4px; border-color: rgba(150, 105, 70, 0.15); }
.card-img { width: 110px; height: 110px; -unity-background-scale-mode: scale-to-fit; border-radius: 16px; }
.card-name { font-size: 26px; -unity-text-align: middle-center; white-space: normal; -unity-font: resource("Fonts/Fredoka-Bold"); margin-top: 4px; }
.card-sub { font-size: 22px; -unity-text-align: middle-center; white-space: normal; color: rgb(140, 110, 90); }
.card.locked { opacity: 0.75; }
.btn { height: 64px; padding: 0 22px; border-radius: 20px; background-color: rgb(255, 143, 171); color: white; font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold");
       border-width: 0; border-bottom-width: 5px; border-color: rgb(224, 104, 138); margin: 6px 4px; }
.btn.mint { background-color: rgb(127, 209, 174); border-color: rgb(79, 174, 137); }
.btn.gold { background-color: rgb(255, 201, 74); border-color: rgb(215, 160, 40); color: rgb(110, 70, 10); }
.btn.ghost { background-color: white; color: rgb(74, 51, 40); border-color: rgb(225, 205, 185); }
.btn.small { height: 56px; font-size: 26px; padding: 0 14px; border-radius: 16px; }
.btn:active { translate: 0 3px; border-bottom-width: 2px; }
.btn.off { opacity: 0.45; }
.listrow { flex-direction: row; align-items: center; background-color: white; border-radius: 20px; padding: 10px; margin-bottom: 10px;
           border-bottom-width: 4px; border-color: rgba(150,105,70,0.12); }
.portrait { width: 96px; height: 96px; border-radius: 48px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-to-fit; margin-right: 12px; }
.name { font-size: 25px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.small { font-size: 22px; color: rgb(140, 110, 90); white-space: normal; }
.hearts { flex-direction: row; margin-top: 3px; }
.heart { width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit; margin-right: 2px; }
.photo { width: 31%; height: 180px; margin: 0 1% 12px 1%; border-radius: 14px; background-color: white; border-width: 6px; border-bottom-width: 22px; border-color: white;
         -unity-background-scale-mode: scale-and-crop; }

/* world bubbles */
.wb { position: absolute; width: 64px; height: 64px; border-radius: 32px; background-color: white; align-items: center; justify-content: center;
      border-bottom-width: 4px; border-color: rgba(150,105,70,0.25); translate: -50% -100%; }
.wb-ico { width: 38px; height: 38px; -unity-background-scale-mode: scale-to-fit; }
.wb-txt { font-size: 23px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(197, 106, 42); }
.wb-badge { display: none; }
/* photo request = a little polaroid of the wanted cat */
.wb.photo { background-color: white; width: auto; height: auto; min-width: 104px; border-radius: 10px; padding: 7px 7px 5px 7px;
            border-width: 3px; border-bottom-width: 5px; border-color: rgb(255, 143, 171); rotate: -3deg; }
.wb.photo .wb-ico { width: 88px; height: 88px; border-radius: 6px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-and-crop; }
.wb.photo.anycat .wb-ico { -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 143, 171); }
.wb.photo .wb-txt { font-size: 20px; color: rgb(214, 92, 128); margin-top: 3px; -unity-text-align: middle-center; }
.wb.photo .wb-badge { display: flex; position: absolute; right: -14px; top: -14px; width: 38px; height: 38px; border-radius: 19px;
            background-color: rgb(255, 143, 171); border-width: 3px; border-color: white; -unity-background-scale-mode: scale-to-fit;
            -unity-background-image-tint-color: white; }
.wb.coins { background-color: rgb(255, 230, 150); width: auto; height: 56px; padding: 0 16px 0 8px; flex-direction: row; border-width: 2px; border-bottom-width: 5px; border-color: rgb(215, 160, 40); border-radius: 28px; }
.wb.paw { background-color: rgb(156, 201, 240); border-color: rgb(110,160,210); }
.wb.paw .wb-ico { -unity-background-image-tint-color: white; }
.wb.lock { width: auto; padding: 0 14px; height: 48px; background-color: rgba(74,51,40,0.88); border-color: rgba(0,0,0,0.3); }
.wb.lock .wb-txt { color: white; font-size: 22px; }
.float { position: absolute; font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(255, 201, 74); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(140, 90, 20);
         translate: -50% -100%; }

.wb.coins .wb-ico { width: 38px; height: 38px; margin-right: 6px; }
.wb.coins .wb-txt { font-size: 28px; color: rgb(140, 84, 20); }
.wb.order { width: 76px; height: 76px; border-radius: 38px; border-width: 2px; border-bottom-width: 5px; border-color: rgba(214, 180, 150, 0.9); }
.wb.order .wb-ico { width: 54px; height: 54px; }
.lockpill { flex-direction: row; align-items: center; align-self: center; background-color: rgb(74, 51, 40); border-radius: 16px; padding: 4px 12px 4px 8px; margin: 6px 0 4px 0; }
.lockpill-ico { width: 22px; height: 22px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: white; margin-right: 6px; }
.lockpill-txt { color: white; font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.card.locked { opacity: 0.75; }
.card.locked .card-img { -unity-background-image-tint-color: rgba(255, 255, 255, 0.45); }
.btn.wide { width: 80%; }

/* toast / modal */
.toast { position: absolute; left: 0; right: 0; top: 196px; align-items: center; opacity: 0; transition-duration: 0.25s; transition-property: opacity, translate; translate: 0 -10px; }
.toast.on { opacity: 1; translate: 0 0; }
.toast-box { background-color: rgba(74, 51, 40, 0.92); border-radius: 18px; padding: 10px 20px; max-width: 90%; }
.toast-text { color: white; font-size: 25px; -unity-text-align: middle-center; white-space: normal; }
.scrim { background-color: rgba(40, 25, 20, 0.45); align-items: center; justify-content: center; }
.modal { width: 86%; background-color: rgb(255, 248, 238); border-radius: 32px; padding: 26px 24px; align-items: center; border-width: 2px; border-bottom-width: 7px; border-color: rgba(214, 180, 150, 0.9); transition-property: scale, opacity; transition-duration: 0.22s, 0.15s; transition-timing-function: ease-out-back, ease-out; }
.modal.modal-in { scale: 0.86 0.86; opacity: 0; }
.modal-title { font-size: 32px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-align: middle-center; white-space: normal; margin-bottom: 6px; }
.modal-text { font-size: 25px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 12px; color: rgb(110, 80, 60); }
.big-portrait { width: 220px; height: 220px; -unity-background-scale-mode: scale-to-fit; margin: 6px; }
.polaroid { width: 300px; height: 375px; background-color: white; border-width: 10px; border-bottom-width: 50px; border-color: white; -unity-background-scale-mode: scale-and-crop;
            rotate: -2deg; margin-bottom: 8px; }
.stars { flex-direction: row; justify-content: center; margin: 4px 0 8px 0; }
.star { width: 34px; height: 34px; -unity-background-scale-mode: scale-to-fit; margin: 0 3px; }
.star.off { -unity-background-image-tint-color: rgba(0,0,0,0.15); }
.step { flex-direction: row; align-items: center; width: 100%; background-color: white; border-radius: 18px; padding: 8px 12px; margin-bottom: 8px; }
.step-dot { width: 30px; height: 30px; border-radius: 15px; background-color: rgb(230, 220, 205); margin-right: 10px; color: white; -unity-text-align: middle-center; -unity-font: resource("Fonts/Fredoka-Bold"); }
.step.done .step-dot { background-color: rgb(127, 209, 174); }

/* viewfinder */
.vf { }
.vf-frame { position: absolute; left: 6%; right: 6%; top: 17%; bottom: 24%; border-width: 3px; border-color: rgba(255,255,255,0.85); border-radius: 28px; }
.vf-top { position: absolute; left: 16px; right: 16px; top: 80px; align-items: center; }
.vf-req { background-color: rgba(255, 143, 171, 0.95); border-radius: 18px; padding: 8px 16px; margin-bottom: 6px; }
.vf-req-pic { width: 46px; height: 46px; border-radius: 8px; background-color: white; margin-right: 10px; -unity-background-scale-mode: scale-and-crop; border-width: 2px; border-color: white; }
.vf-req-text { color: white; font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-align: middle-left; white-space: normal; flex-shrink: 1; }
.vf-name { background-color: rgba(74,51,40,0.85); border-radius: 20px; padding: 8px 20px; color: white; font-size: 28px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.vf-bottom { position: absolute; left: 0; right: 0; bottom: 40px; flex-direction: row; justify-content: center; align-items: center; }
.shutter { width: 110px; height: 110px; border-radius: 55px; background-color: white; border-width: 8px; border-color: rgb(255, 143, 171); margin: 0 30px; }
.shutter:active { scale: 0.92 0.92; }
.vf .star { width: 44px; height: 44px; margin: 0 4px; }
.vf-bottom .ibtn { width: 76px; height: 76px; border-radius: 38px; padding: 16px; }
.flash { background-color: white; opacity: 0; transition-duration: 0.35s; transition-property: opacity; }
.flash.on { opacity: 0.9; transition-duration: 0s; }

.coach { position: absolute; left: 16px; right: 16px; top: 100px; align-items: center; }
.coach-box { flex-direction: row; align-items: center; background-color: rgba(255, 250, 243, 0.97); border-radius: 22px; padding: 10px 16px; border-width: 2px; border-bottom-width: 5px; border-color: rgb(255, 170, 120); max-width: 100%; }
.coach-ico { width: 40px; height: 40px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.coach-text { color: rgb(74, 51, 40); font-size: 26px; white-space: normal; flex-shrink: 1; }

/* ---- touch states ----------------------------------------------------------------------------------------
   Unity's default runtime theme greys out .unity-button on :hover/:focus. On a phone :hover "sticks" after a tap,
   so buttons turned grey. Re-state each look for those states and give a gentle press feedback instead. */
.unity-button { -unity-text-align: middle-center; }
.root .btn:hover, .root .btn:focus { background-color: rgb(255, 143, 171); border-color: rgb(224, 104, 138); color: white; }
.root .btn.mint:hover, .root .btn.mint:focus { background-color: rgb(127, 209, 174); border-color: rgb(79, 174, 137); color: white; }
.root .btn.gold:hover, .root .btn.gold:focus { background-color: rgb(255, 201, 74); border-color: rgb(215, 160, 40); color: rgb(110, 70, 10); }
.root .btn.ghost:hover, .root .btn.ghost:focus { background-color: white; border-color: rgb(225, 205, 185); color: rgb(74, 51, 40); }
.root .btn:active { translate: 0 3px; border-bottom-width: 2px; }
.root .ibtn:hover, .root .ibtn:focus { background-color: rgb(255, 250, 243); border-color: rgba(214, 180, 150, 0.9); }
.root .ibtn:active { scale: 0.92 0.92; }
.root .tab:hover, .root .tab:focus { background-color: rgba(255, 226, 235, 0); border-color: rgba(255, 143, 171, 0); }
.root .tab.on:hover, .root .tab.on:focus { background-color: rgb(255, 226, 235); border-color: rgb(255, 143, 171); }
.root .tab:active { scale: 0.94 0.94; }
.root .chip:hover, .root .chip:focus { background-color: white; border-color: rgba(150, 105, 70, 0.2); color: rgb(74, 51, 40); }
.root .chip.on:hover, .root .chip.on:focus { background-color: rgb(127, 209, 174); color: white; }
.root .shutter:hover, .root .shutter:focus { background-color: white; border-color: rgb(255, 143, 171); }

/* ---- cats: cards + profile ------------------------------------------------------------------------------- */
.catgrid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.catcard { width: 48.6%; flex-direction: column; align-items: center; background-color: white; border-radius: 26px; padding: 14px 10px 14px 10px;
           margin: 0 0 12px 0; border-width: 2px; border-bottom-width: 6px; border-color: rgb(232, 218, 204); white-space: normal; }
.root .catcard:hover, .root .catcard:focus { background-color: white; border-color: rgb(232, 218, 204); }
.root .catcard:active { scale: 0.97 0.97; }
.cat-ring { width: 124px; height: 124px; border-radius: 62px; background-color: rgb(255, 236, 222); border-width: 5px; border-color: rgb(205, 190, 175);
            align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
.cat-ring.big { width: 150px; height: 150px; border-radius: 75px; margin-right: 16px; }
.cat-pic { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.rarity-chip { position: absolute; left: 10px; top: 10px; font-size: 20px; color: white; -unity-font: resource("Fonts/Fredoka-Bold");
               background-color: rgb(175, 155, 135); border-radius: 12px; padding: 3px 10px; }
.cat-head .rarity-chip { position: relative; left: 0; top: 0; align-self: flex-start; margin-bottom: 4px; }
.catcard-name { font-size: 29px; -unity-font: resource("Fonts/Fredoka-Bold"); margin-top: 8px; -unity-text-align: middle-center; }
.catcard-sub { font-size: 20px; color: rgb(150, 115, 95); -unity-text-align: middle-center; white-space: normal; }
.catcard .hearts { justify-content: center; margin: 6px 0 6px 0; }
.catcard-status { font-size: 20px; color: rgb(60, 140, 108); background-color: rgb(222, 245, 235); border-radius: 12px; padding: 3px 12px; align-self: center; }
.cat-head .catcard-status { align-self: flex-start; margin-top: 6px; }
.catcard-status.off { color: rgb(170, 110, 60); background-color: rgb(255, 236, 210); }
.heart { width: 24px; height: 24px; }
.heart.off { -unity-background-image-tint-color: rgba(120, 90, 70, 0.18); }
/* rarity colours */
.r-uncommon .cat-ring, .catcard.r-uncommon { border-color: rgb(127, 209, 174); }
.r-uncommon .rarity-chip { background-color: rgb(79, 174, 137); }
.r-rare .cat-ring, .catcard.r-rare { border-color: rgb(120, 175, 240); }
.r-rare .rarity-chip { background-color: rgb(84, 140, 220); }
.r-legendary .cat-ring, .catcard.r-legendary { border-color: rgb(255, 196, 70); }
.r-legendary .rarity-chip { background-color: rgb(230, 160, 30); }
.root .catcard.r-uncommon:hover { border-color: rgb(127, 209, 174); }
.root .catcard.r-rare:hover { border-color: rgb(120, 175, 240); }
.root .catcard.r-legendary:hover { border-color: rgb(255, 196, 70); }
/* profile */
.modal.catmodal { width: 92%; align-items: stretch; padding: 22px 20px 18px 20px; }
.cat-head { flex-direction: row; align-items: center; margin-bottom: 12px; }
.cat-name { font-size: 39px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.cat-sub { font-size: 23px; color: rgb(150, 115, 95); white-space: normal; }
.cat-box { background-color: white; border-radius: 22px; padding: 12px 16px 14px 16px; margin-bottom: 10px; border-bottom-width: 4px; border-color: rgb(238, 226, 214); }
.cat-label { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.cat-hint { font-size: 20px; color: rgb(150, 115, 95); white-space: normal; margin-top: 6px; }
.cat-count { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(214, 82, 122); }
.charm-pill { font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(214, 82, 122); background-color: rgb(255, 228, 236); border-radius: 14px; padding: 4px 12px; }
.stat-row { flex-direction: row; align-items: center; margin-top: 9px; }
.stat-name { width: 122px; font-size: 23px; color: rgb(110, 80, 60); }
.stat-track { flex-grow: 1; height: 16px; border-radius: 8px; background-color: rgb(244, 235, 226); overflow: hidden; }
.stat-fill { height: 100%; border-radius: 8px; }
.stat-fill.c1 { background-color: rgb(255, 143, 171); }
.stat-fill.c2 { background-color: rgb(120, 175, 240); }
.stat-fill.c3 { background-color: rgb(127, 209, 174); }
.stat-fill.c4 { background-color: rgb(186, 160, 230); }
.stat-fill.c5 { background-color: rgb(255, 190, 90); }
.pose-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-top: 10px; }
.pose { width: 31.5%; margin-bottom: 10px; align-items: center; }
.pose-pic { width: 100%; height: 112px; border-radius: 14px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-and-crop;
            border-width: 3px; border-color: white; align-items: center; justify-content: center; }
.pose-pic.empty { background-color: rgb(244, 235, 226); border-color: rgb(244, 235, 226); }
.pose-q { font-size: 40px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgba(150, 120, 100, 0.45); }
.pose-stars { flex-direction: row; position: absolute; top: 88px; background-color: rgba(255, 255, 255, 0.92); border-radius: 10px; padding: 2px 5px; }
.star.tiny { width: 16px; height: 16px; margin: 0 1px; }
.pose-name { font-size: 20px; color: rgb(110, 80, 60); margin-top: 3px; }
.card { }

/* ---- cat care ------------------------------------------------------------------------------------------- */
.supplies { flex-direction: row; justify-content: space-between; margin-bottom: 10px; }
.supply { width: 49%; flex-direction: row; align-items: center; background-color: white; border-radius: 20px; padding: 6px 6px 6px 10px; border-bottom-width: 4px; border-color: rgba(150,105,70,0.12); }
.supply-ico { width: 44px; height: 44px; -unity-background-scale-mode: scale-to-fit; margin-right: 6px; }
.supply-val { font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); margin-right: 4px; }
.supply-lbl { font-size: 20px; color: rgb(150, 115, 95); flex-grow: 1; }
.supply .btn.small { height: 50px; font-size: 21px; padding: 0 10px; margin: 0; }
.needs { margin-top: 8px; }
.needs.mini { width: 88%; margin: 2px 0 6px 0; }
.need-row { flex-direction: row; align-items: center; margin-top: 7px; }
.needs.mini .need-row { margin-top: 3px; }
.need-ico { width: 30px; height: 30px; -unity-background-scale-mode: scale-to-fit; margin-right: 8px; }
.needs.mini .need-ico { width: 20px; height: 20px; margin-right: 6px; }
.need-name { width: 92px; font-size: 22px; color: rgb(110, 80, 60); }
.need-track { flex-grow: 1; height: 16px; border-radius: 8px; background-color: rgb(244, 235, 226); overflow: hidden; }
.needs.mini .need-track { height: 9px; border-radius: 5px; }
.need-fill { height: 100%; border-radius: 8px; }
.need-fill.n-food { background-color: rgb(255, 178, 90); }
.need-fill.n-happy { background-color: rgb(255, 143, 171); }
.need-fill.n-health { background-color: rgb(127, 209, 174); }
.need-fill.low { background-color: rgb(235, 90, 90); }
.need-val { width: 50px; font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-align: middle-right; color: rgb(110, 80, 60); }
.catcard-status.alert { color: white; background-color: rgb(235, 100, 100); }
.care-alert { position: absolute; right: 10px; top: 10px; width: 46px; height: 46px; border-radius: 23px; background-color: rgb(255, 236, 236); border-width: 3px; border-color: rgb(235, 100, 100); -unity-background-scale-mode: scale-to-fit; }
.charm-pill.mint { color: rgb(40, 130, 95); background-color: rgb(222, 245, 235); }
.charm-pill.warn { color: white; background-color: rgb(235, 100, 100); }
.charm-pill.shard { color: rgb(120, 80, 200); background-color: rgb(236, 228, 255); }
.btn.rename { margin-left: 12px; height: 44px; font-size: 20px; padding: 0 12px; }
.wb.care { width: 62px; height: 62px; border-radius: 31px; background-color: white; border-width: 3px; border-bottom-width: 5px; border-color: rgb(255, 178, 90); }
.wb.care .wb-ico { width: 42px; height: 42px; }
.wb.care.sick { border-color: rgb(235, 100, 100); background-color: rgb(255, 238, 238); }
.namefield { width: 80%; margin: 10px 0 6px 0; }
.namefield .unity-text-field__input, .namefield .unity-base-text-field__input { font-size: 34px; -unity-font: resource("Fonts/Fredoka-Bold"); height: 72px; border-radius: 18px; background-color: white; border-width: 3px; border-color: rgb(255, 143, 171); padding: 0 18px; -unity-text-align: middle-center; color: rgb(74, 51, 40); }

/* ---- shelter gacha ---------------------------------------------------------------------------------------- */
.featured { flex-direction: row; align-items: center; background-color: rgb(255, 244, 214); border-radius: 26px; padding: 12px 14px; margin-bottom: 10px; border-width: 3px; border-bottom-width: 6px; border-color: rgb(255, 196, 70); }
.featured.r-rare { background-color: rgb(229, 239, 255); border-color: rgb(120, 175, 240); }
.featured .cat-ring { width: 112px; height: 112px; border-radius: 56px; margin-right: 14px; }
.feat-tag { font-size: 19px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(214, 82, 122); letter-spacing: 1px; }
.feat-name { font-size: 36px; -unity-font: resource("Fonts/Fredoka-Bold"); }
.feat-sub { font-size: 21px; color: rgb(130, 100, 80); white-space: normal; }
.pity { background-color: white; border-radius: 22px; padding: 10px 16px 14px 16px; margin-bottom: 8px; border-bottom-width: 4px; border-color: rgb(238, 226, 214); }
.pips { flex-direction: row; justify-content: space-between; margin-top: 10px; }
.pip { flex-grow: 1; height: 16px; border-radius: 8px; margin: 0 3px; background-color: rgb(244, 235, 226); }
.pip.on { background-color: rgb(120, 175, 240); }
.pip.last { background-color: rgb(255, 210, 110); }
.btn.big { height: 80px; font-size: 30px; padding: 0 28px; border-radius: 26px; border-bottom-width: 7px; }
.shelter-why { font-size: 22px; color: rgb(214, 82, 82); -unity-text-align: middle-center; white-space: normal; margin-bottom: 10px; }
.shelter-why.ok { color: rgb(60, 140, 108); }
.shard-ico { width: 60px; height: 60px; border-radius: 30px; background-color: rgb(236, 228, 255); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(150, 110, 230); margin-right: 12px; padding: 8px; }
.odds { font-size: 20px; color: rgb(150, 120, 100); white-space: normal; background-color: rgb(248, 240, 230); border-radius: 16px; padding: 10px 14px; margin-bottom: 10px; }
.shard-list { max-height: 900px; }
.catcard.small { padding: 10px 8px 10px 8px; }
.catcard.small .cat-ring { width: 96px; height: 96px; border-radius: 48px; }
.catcard.small .catcard-name { font-size: 25px; }
.tag { font-size: 20px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; border-radius: 12px; padding: 3px 12px; margin: 0 4px 6px 4px; align-self: center; }
.tag.feat { background-color: rgb(214, 82, 122); }
.tag.guar { background-color: rgb(84, 140, 220); }
.tag.new { background-color: rgb(255, 99, 99); font-size: 24px; }
.tag.dup { background-color: rgb(150, 110, 230); }
.tag.corner { position: absolute; right: 8px; top: 8px; margin: 0; }
.rarity-chip.big { position: relative; left: 0; top: 0; font-size: 24px; padding: 5px 16px; margin: 0 4px 6px 4px; }

.confetti { position: absolute; width: 16px; height: 10px; border-radius: 3px; }
/* shelter: compact info chips */
.shelter-info { flex-direction: row; flex-wrap: wrap; justify-content: center; margin: 6px 0 10px 0; }
.info-chip { flex-direction: row; align-items: center; background-color: white; border-radius: 22px; padding: 6px 14px 6px 8px; margin: 4px; border-width: 0; border-bottom-width: 4px; border-color: rgba(150,105,70,0.15); height: 52px; }
.root .info-chip:hover, .root .info-chip:focus { background-color: white; border-color: rgba(150,105,70,0.15); }
.root .info-chip.tap:active { scale: 0.95 0.95; }
.info-chip.tap { border-color: rgb(127, 209, 174); border-width: 2px; border-bottom-width: 4px; }
.root .info-chip.tap:hover, .root .info-chip.tap:focus { border-color: rgb(127, 209, 174); }
.info-ico { width: 34px; height: 34px; -unity-background-scale-mode: scale-to-fit; margin-right: 6px; -unity-background-image-tint-color: rgb(255, 143, 171); }
.info-ico.shard { -unity-background-image-tint-color: rgb(150, 110, 230); }
.info-txt { font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(110, 80, 60); }
.odds-row { margin: 4px 0; }
.odds-pct { font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); }

/* ---- shelter page (3D lobby) + cutscene -------------------------------------------------------------- */
.spage { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 104px 18px 150px 18px; align-items: center; }
.feat-ribbon { align-items: center; background-color: rgba(255, 250, 243, 0.94); border-radius: 26px; padding: 10px 34px 12px 34px; border-width: 3px; border-bottom-width: 6px; border-color: rgb(255, 196, 70); }
.feat-ribbon.r-rare { border-color: rgb(120, 175, 240); }
.feat-ribbon .feat-name { font-size: 44px; }
.feat-ribbon .feat-sub { -unity-text-align: middle-center; }
.sbottom { width: 100%; align-items: center; }
.spity { width: 76%; align-items: center; background-color: rgba(255, 250, 243, 0.9); border-radius: 20px; padding: 8px 16px 12px 16px; margin-bottom: 12px; }
.spity-txt { font-size: 23px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(84, 120, 190); }
.spity .pips { width: 100%; margin-top: 6px; }
.spity .pip { height: 12px; }
.srow { flex-direction: row; align-items: center; justify-content: center; width: 100%; }
.sround { width: 96px; height: 96px; border-radius: 48px; background-color: rgb(255, 250, 243); border-width: 2px; border-bottom-width: 6px; border-color: rgba(214, 180, 150, 0.9); align-items: center; justify-content: center; padding: 0; margin: 0 10px; }
.root .sround:hover, .root .sround:focus { background-color: rgb(255, 250, 243); border-color: rgba(214, 180, 150, 0.9); }
.root .sround:active { scale: 0.93 0.93; }
.sround-ico { width: 42px; height: 42px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 143, 171); }
.sround-ico.shard { -unity-background-image-tint-color: rgb(150, 110, 230); }
.sround-lbl { font-size: 20px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(110, 80, 60); }
.adopt { width: 300px; height: 112px; border-radius: 34px; background-color: rgb(255, 201, 74); border-width: 0; border-bottom-width: 9px; border-color: rgb(215, 160, 40); align-items: center; justify-content: center; padding: 0; margin: 0; }
.root .adopt:hover, .root .adopt:focus { background-color: rgb(255, 201, 74); border-color: rgb(215, 160, 40); }
.root .adopt:active { translate: 0 4px; border-bottom-width: 5px; }
.adopt.off { opacity: 0.5; }
.adopt-lbl { font-size: 42px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(110, 70, 10); margin-bottom: -4px; }
.adopt-cost { flex-direction: row; align-items: center; }
.adopt-ico { width: 26px; height: 26px; -unity-background-scale-mode: scale-to-fit; margin: 0 4px 0 10px; }
.adopt-num { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(140, 90, 20); }
.spage .shelter-why { margin-top: 10px; background-color: rgba(255, 250, 243, 0.9); border-radius: 14px; padding: 4px 14px; }
.cine { }
.cflash { background-color: white; opacity: 0; }
.skip-hint { position: absolute; bottom: 60px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 24px; color: rgba(255, 255, 255, 0.7); }
.rcard { position: absolute; left: 22px; right: 22px; bottom: 40px; background-color: rgb(255, 248, 238); border-radius: 34px; padding: 22px 20px 18px 20px; align-items: center;
         border-width: 3px; border-bottom-width: 8px; border-color: rgb(214, 180, 150); transition-property: translate, opacity; transition-duration: 0.35s; transition-timing-function: ease-out-back; }
.rcard.off { translate: 0 120%; opacity: 0; }
.rcard.r-uncommon { border-color: rgb(127, 209, 174); }
.rcard.r-rare { border-color: rgb(120, 175, 240); }
.rcard.r-legendary { border-color: rgb(255, 196, 70); }
.rcard .rarity-chip.big { background-color: rgb(175, 155, 135); }
.rcard.r-uncommon .rarity-chip { background-color: rgb(79, 174, 137); }
.rcard.r-rare .rarity-chip { background-color: rgb(84, 140, 220); }
.rcard.r-legendary .rarity-chip { background-color: rgb(230, 160, 30); }
.rcard-name { font-size: 52px; -unity-font: resource("Fonts/Fredoka-Bold"); margin-top: 2px; }
.rcard-sub { font-size: 24px; color: rgb(130, 100, 80); -unity-text-align: middle-center; white-space: normal; margin-bottom: 8px; }

/* =====================================================================================================
   GLOSSY "CANDY" SKIN — 9-sliced textures in Resources/UI/Skins (gloss band on top, darker 3D lip below).
   Buttons: fixed heights, a minimum width, grow to fit their text (never clipped), always centred text.
   ===================================================================================================== */
.root .btn, .root .btn:hover, .root .btn:focus {
    background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_pink");
    -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.5px;
    border-width: 0; height: 76px; min-width: 190px; padding: 0 30px 8px 30px; margin: 6px 6px;
    color: white; font-size: 27px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-align: middle-center; white-space: nowrap;
    flex-shrink: 0; text-shadow: 0 2px 0 rgba(170, 40, 85, 0.9); -unity-text-outline-width: 0;
}
.root .btn:active { translate: 0 3px; scale: 0.97 0.97; border-width: 0; }
.root .btn.mint, .root .btn.mint:hover, .root .btn.mint:focus { background-image: resource("UI/Skins/btn_mint"); color: white; text-shadow: 0 2px 0 rgba(20, 120, 80, 0.9); }
.root .btn.gold, .root .btn.gold:hover, .root .btn.gold:focus { background-image: resource("UI/Skins/btn_gold"); color: white; text-shadow: 0 2px 0 rgba(170, 95, 0, 0.95); }
.root .btn.ghost, .root .btn.ghost:hover, .root .btn.ghost:focus { background-image: resource("UI/Skins/btn_cream"); color: rgb(110, 72, 50); text-shadow: 0 2px 0 rgba(255, 255, 255, 0.9); }
.root .btn.small, .root .btn.small:hover, .root .btn.small:focus { height: 62px; min-width: 140px; padding: 0 20px 7px 20px; font-size: 23px; }
.root .btn.wide { width: 82%; }
.root .btn.big { height: 92px; min-width: 300px; font-size: 32px; }
.root .btn.rename { height: 50px; min-width: 0; padding: 0 16px 6px 16px; font-size: 20px; margin-left: 12px; }
.root .btn.off { opacity: 0.5; }
.row { justify-content: center; }
.row > .grow { flex-shrink: 1; }

/* chips */
.root .chip, .root .chip:hover, .root .chip:focus {
    background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_cream");
    -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.4px;
    border-width: 0; height: 58px; min-width: 110px; padding: 0 18px 6px 18px; font-size: 24px; color: rgb(110, 72, 50); -unity-text-align: middle-center; white-space: nowrap; flex-shrink: 0;
}
.root .chip.on, .root .chip.on:hover, .root .chip.on:focus { background-image: resource("UI/Skins/btn_mint"); color: white; text-shadow: 0 2px 0 rgba(20, 120, 80, 0.9); }

/* round icon buttons */
.root .ibtn, .root .ibtn:hover, .root .ibtn:focus, .root .sround, .root .sround:hover, .root .sround:focus {
    background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/circ_cream"); border-width: 0; -unity-background-scale-mode: stretch-to-fill;
}
.root .ibtn { padding: 14px 14px 18px 14px; width: 70px; height: 72px; }
.ibtn { align-items: center; justify-content: center; }
.ibtn-ico { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.root .sround { width: 104px; height: 106px; padding: 0 0 8px 0; }
.sround-lbl { -unity-text-align: middle-center; }

/* adopt */
.root .adopt, .root .adopt:hover, .root .adopt:focus {
    background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_gold"); border-width: 0;
    -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.6px;
    width: 310px; height: 124px; padding-bottom: 10px;
}
.root .adopt:active { translate: 0 3px; scale: 0.97 0.97; border-width: 0; }
.adopt-lbl { color: white; text-shadow: 0 3px 0 rgba(170, 95, 0, 0.95); font-size: 44px; }
.adopt-num { color: rgb(120, 70, 0); }

/* top bar pills + level badge */
.pill { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_cream"); border-width: 0;
        -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.45px; padding: 5px 18px 9px 6px; }
.lvl { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/circ_pink"); border-width: 0; -unity-background-scale-mode: stretch-to-fill; }
.lvl-num { text-shadow: 0 2px 0 rgba(170, 40, 85, 0.9); }

/* tab bar + selected tab */
.tabs { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/panel_cream"); border-width: 0;
        -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.6px; padding: 10px 10px 16px 10px; }
.root .tab.on, .root .tab.on:hover, .root .tab.on:focus { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_blush"); border-width: 0;
        -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.5px; }
.tab-lbl { white-space: nowrap; -unity-text-align: middle-center; }

/* panels: modals, sheets, list rows, cards */
.modal { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/panel_cream"); border-width: 0;
         -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.6px; padding: 28px 26px 32px 26px; }
.rcard { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/panel_cream");
         -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.6px; padding-bottom: 28px; }
.card, .listrow, .cat-box, .supply, .pity, .spity { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/panel_white"); border-width: 0;
         -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.4px; padding-bottom: 14px; }
.feat-ribbon { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/panel_cream");
         -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.5px; padding-bottom: 16px; }

/* text never clips: names and labels wrap instead */
.card-name, .card-sub, .catcard-name, .catcard-sub, .modal-title, .modal-text, .rcard-name, .rcard-sub, .feat-name, .name, .small, .cat-hint, .sheet-sub { white-space: normal; }
.catcard-name, .card-name { -unity-text-align: middle-center; }
.catcard .btn, .card .btn { min-width: 0; align-self: stretch; margin: 6px 4px 0 4px; }
.supply .btn { min-width: 0; }

/* ---- FIXED SIZES: every button / chip / card class has one size; text shrinks to fit (CafeUI.Fit), boxes never grow or shrink */
.root .btn, .root .btn:hover, .root .btn:focus { width: 236px; min-width: 0; max-width: none; flex-grow: 0; flex-shrink: 0; padding: 0 22px 8px 22px; overflow: hidden; }
.root .btn.small, .root .btn.small:hover, .root .btn.small:focus { width: 176px; height: 62px; padding: 0 14px 7px 14px; }
.root .btn.big, .root .btn.big:hover, .root .btn.big:focus { width: 320px; height: 92px; }
.root .btn.wide, .root .btn.wide:hover, .root .btn.wide:focus { width: 82%; }
.root .btn.rename, .root .btn.rename:hover, .root .btn.rename:focus { width: 120px; height: 50px; padding: 0 10px 6px 10px; }
.root .chip, .root .chip:hover, .root .chip:focus { width: 31.3%; min-width: 0; margin: 0 1% 8px 1%; padding: 0 8px 6px 8px; overflow: hidden; }
.chips { justify-content: flex-start; }
.card .btn, .catcard .btn, .supply .btn { width: 92%; align-self: center; margin: 6px 0 0 0; }
.root .card .btn.small, .root .catcard .btn.small { width: 92%; }
.root .supply .btn.small { width: 150px; height: 54px; }
.card { width: 31.3%; height: 272px; margin: 0 1% 12px 1%; justify-content: flex-start; overflow: hidden; }
.card-name, .card-sub { white-space: nowrap; width: 100%; -unity-text-align: middle-center; }
.catcard { height: 372px; justify-content: flex-start; overflow: hidden; }
.catcard.small { height: 300px; }
.catcard-name, .catcard-sub { white-space: nowrap; width: 96%; -unity-text-align: middle-center; }
.photo { height: 180px; }
.listrow { min-height: 104px; }

/* ---- shelter play yard + feather minigame */
.yard-title { align-self: center; font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; text-shadow: 0 2px 0 rgba(90, 60, 120, 0.7);
              background-color: rgba(120, 90, 160, 0.35); border-radius: 18px; padding: 4px 18px; }
.lure-box { position: absolute; left: 30px; right: 30px; top: 70px; align-items: center; }
.lure-text { font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; -unity-text-align: middle-center; text-shadow: 0 3px 0 rgba(90, 60, 120, 0.8); white-space: nowrap; width: 100%; }
.lure-track { width: 70%; height: 26px; border-radius: 13px; background-color: rgba(255, 255, 255, 0.55); margin-top: 12px; border-width: 3px; border-color: white; overflow: hidden; }
.lure-fill { height: 100%; border-radius: 10px; background-color: rgb(255, 143, 171); }
.feather { position: absolute; width: 130px; height: 130px; translate: -30% -85%; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 120, 165); transform-origin: 30% 85%; }
/* buttons sharing a row split it evenly (same size as each other), capped at the standard width */
.root .row > .btn, .root .row > .btn:hover, .root .row > .btn:focus { width: auto; flex-basis: 0; flex-grow: 1; max-width: 236px; margin: 6px 5px; padding: 0 10px 8px 10px; }
.root .row > .btn.small, .root .row > .btn.small:hover, .root .row > .btn.small:focus { max-width: 176px; }
.root .row > .btn.rename { flex-grow: 0; flex-basis: auto; width: 120px; }
/* rows of buttons in cards/modals use the full width so evenly-split buttons get their size */
.modal > .row, .rcard > .row, .cat-box > .row { align-self: stretch; }

/* ---- Decorate: slim bar + Shop modal -------------------------------------------------------------- */
.decor-bar { position: absolute; left: 16px; right: 16px; bottom: 148px; flex-direction: row; align-items: center; }
.decor-hint { flex-grow: 1; flex-shrink: 1; margin-right: 12px; padding: 12px 20px 16px 20px; background-image: resource("UI/Skins/panel_cream");
              -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.45px; }
.decor-hint-txt { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); }
.decor-hint-sub { font-size: 20px; color: rgb(150, 115, 95); }
.shop-btn { width: 128px; height: 128px; padding: 0 0 12px 0; margin: 0; align-items: center; justify-content: center; border-width: 0;
            background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/circ_gold"); -unity-background-scale-mode: stretch-to-fill; }
.root .shop-btn:hover, .root .shop-btn:focus { background-color: rgba(0,0,0,0); }
.root .shop-btn:active { scale: 0.93 0.93; }
.shop-btn-ico { width: 54px; height: 54px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: white; }
.shop-btn-lbl { font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(170, 95, 0); text-shadow: 0 2px 0 rgba(170, 95, 0, 0.95); margin-top: -2px; }

.modal.shop { width: 94%; height: 80%; align-items: stretch; padding: 20px 18px 26px 18px; }
.shop-head { flex-direction: row; align-items: center; margin-bottom: 12px; }
.shop-title { font-size: 40px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); margin-right: 14px; }
.shop-head .pill { margin: 0; }
.shop-head .ibtn { margin: 0; }
.shop-tabs { flex-direction: row; justify-content: space-between; margin-bottom: 12px; }
.shop-tab { width: 15.6%; height: 108px; padding: 4px 0 12px 0; margin: 0; border-width: 0; align-items: center; justify-content: center;
            background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_cream");
            -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.4px; }
.root .shop-tab:hover, .root .shop-tab:focus { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_cream"); }
.shop-tab.on, .root .shop-tab.on:hover, .root .shop-tab.on:focus { background-image: resource("UI/Skins/btn_blush"); translate: 0 -4px; }
.root .shop-tab:active { scale: 0.94 0.94; }
.shop-tab-ico { width: 52px; height: 52px; -unity-background-scale-mode: scale-to-fit; }
.shop-tab-lbl { width: 94%; font-size: 18px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(110, 72, 50); -unity-text-align: middle-center; white-space: nowrap; margin-top: 2px; }
.shop-tab.on .shop-tab-lbl { color: rgb(214, 82, 122); }
.shop-scroll { flex-grow: 1; flex-shrink: 1; }
.sgrid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.scard { width: 32%; height: 318px; margin-bottom: 12px; align-items: center; padding: 12px 8px 16px 8px; overflow: hidden;
         background-image: resource("UI/Skins/panel_white"); -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.4px; }
.scard-pic { width: 128px; height: 128px; border-radius: 64px; background-color: rgb(255, 238, 226); align-items: center; justify-content: center; margin-bottom: 4px; }
.scard-img { width: 108px; height: 108px; -unity-background-scale-mode: scale-to-fit; }
.scard .card-name { font-size: 24px; margin-top: 2px; }
.scard .card-sub { font-size: 19px; margin-bottom: 4px; }
.scard.locked .scard-img { -unity-background-image-tint-color: rgba(255, 255, 255, 0.45); }
.scard .lockpill { position: absolute; bottom: 16px; }
.scard-status { position: absolute; bottom: 20px; font-size: 21px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(60, 140, 108); background-color: rgb(222, 245, 235); border-radius: 14px; padding: 4px 14px; }
.scard-corner { position: absolute; right: 10px; top: 10px; font-size: 18px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; background-color: rgb(150, 105, 240); border-radius: 12px; padding: 2px 10px; }
.price { position: absolute; bottom: 14px; left: 10px; right: 10px; height: 62px; flex-direction: row; align-items: center; justify-content: center; padding: 0 0 8px 0; margin: 0; border-width: 0;
         background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_gold"); -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.45px; }
.root .price:hover, .root .price:focus { background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_gold"); }
.root .price:active { scale: 0.95 0.95; }
.price.off { opacity: 0.5; }
.price-ico { width: 30px; height: 30px; -unity-background-scale-mode: scale-to-fit; margin-right: 6px; }
.price-lbl { font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(170, 95, 0); text-shadow: 0 2px 0 rgba(170, 95, 0, 0.95); }

/* readable white-on-gloss text everywhere */
.root .btn, .root .chip.on, .adopt-lbl, .lvl-num { -unity-text-outline-width: 1px; }
.root .btn { -unity-text-outline-color: rgb(190, 60, 105); }
.root .btn.mint, .root .chip.on { -unity-text-outline-color: rgb(25, 120, 82); }
.root .btn.gold, .adopt-lbl { -unity-text-outline-color: rgb(170, 95, 0); }
.root .btn.ghost { -unity-text-outline-width: 0; }
.root .chip.on { color: white; text-shadow: 0 2px 0 rgba(25, 120, 82, 0.95); }
.sgrid { justify-content: flex-start; }
.scard { width: 31.3%; margin: 0 1% 12px 1%; }
.modal.shop { height: 76%; margin-bottom: 40px; }

/* shop categories v2: two rows of three wide glossy pills (icon disc + big label) */
.shop-tabs { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 10px; }
.shop-tab, .root .shop-tab:hover, .root .shop-tab:focus {
    width: 32.4%; height: 74px; margin: 0 0 8px 0; padding: 0 10px 7px 8px; flex-direction: row; align-items: center; justify-content: flex-start;
    background-image: resource("UI/Skins/btn_cream"); -unity-slice-scale: 0.42px; translate: 0 0; }
.shop-tab.on, .root .shop-tab.on:hover, .root .shop-tab.on:focus { background-image: resource("UI/Skins/btn_pink"); translate: 0 0; }
.shop-tab-icobg { width: 50px; height: 50px; border-radius: 25px; background-color: rgba(255, 255, 255, 0.95); align-items: center; justify-content: center; flex-shrink: 0; margin-right: 8px; }
.shop-tab-ico { width: 38px; height: 38px; -unity-background-scale-mode: scale-to-fit; }
.shop-tab-lbl { width: auto; flex-grow: 1; flex-shrink: 1; font-size: 24px; -unity-text-align: middle-left; margin-top: 0; color: rgb(110, 72, 50); }
.shop-tab.on .shop-tab-lbl { color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(190, 60, 105); text-shadow: 0 2px 0 rgba(170, 40, 85, 0.9); }
/* minigame instruction: readable on any background */
.lure-box { top: 24px; padding: 14px 18px 18px 18px; border-radius: 26px; background-color: rgba(70, 45, 95, 0.55); }
.lure-text { white-space: normal; }

/* ---- Friends --------------------------------------------------------------------------------------- */
.search-row { margin: 10px 0 6px 0; justify-content: space-between; }
.searchfield { flex-grow: 1; flex-shrink: 1; margin: 0 8px 0 0; }
.searchfield .unity-text-field__input, .searchfield .unity-base-text-field__input { font-size: 26px; height: 62px; border-radius: 18px; background-color: white; border-width: 3px; border-color: rgb(232, 210, 190); padding: 0 16px; color: rgb(74, 51, 40); -unity-font: resource("Fonts/Fredoka-SemiBold"); }
.root .search-row > .btn, .root .search-row > .btn:hover, .root .search-row > .btn:focus { flex-grow: 0; flex-basis: auto; width: 150px; }
.list-head { font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(150, 115, 95); margin: 10px 4px 6px 4px; }
.person { height: 108px; padding: 10px 10px 14px 12px; }
.root .person > .btn, .root .person > .btn:hover, .root .person > .btn:focus { width: 130px; height: 58px; flex-grow: 0; margin: 0 4px; }
.feed-av { width: 72px; height: 72px; border-radius: 36px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-to-fit; margin-right: 12px; flex-shrink: 0; border-width: 3px; border-color: white; }
.xbtn { width: 44px; height: 44px; border-radius: 22px; background-color: rgb(244, 235, 226); border-width: 0; padding: 10px; margin: 0 0 0 4px; }
.root .xbtn:hover, .root .xbtn:focus { background-color: rgb(244, 235, 226); }
.xbtn .ibtn-ico { -unity-background-image-tint-color: rgb(170, 135, 112); }
.cat-box > .row { justify-content: flex-start; }
.cat-box .btn.small { width: 140px; }

/* ---- Whisker Feed cards */
.feedcard { background-image: resource("UI/Skins/panel_white"); -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.4px;
            padding: 12px 14px 18px 14px; margin-bottom: 14px; }
.feed-head { justify-content: flex-start; margin-bottom: 8px; }
.feed-head .feed-av { width: 60px; height: 60px; }
.feed-pic { width: 100%; height: 520px; border-radius: 18px; background-color: rgb(255, 238, 226); -unity-background-scale-mode: scale-and-crop; }
.feed-foot { justify-content: flex-start; margin-top: 10px; }
.like { flex-direction: row; align-items: center; height: 56px; padding: 0 18px 6px 12px; border-width: 0; margin: 0;
        background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/btn_cream"); -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.4px; }
.root .like:hover, .root .like:focus { background-color: rgba(0,0,0,0); }
.like.on, .root .like.on:hover, .root .like.on:focus { background-image: resource("UI/Skins/btn_blush"); }
.root .like:active { scale: 0.92 0.92; }
.like-ico { width: 32px; height: 32px; -unity-background-scale-mode: scale-to-fit; margin-right: 8px; }
.like-num { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(214, 82, 122); }

/* ---- visiting a friend */
.visit-bar { position: absolute; left: 16px; right: 16px; top: 16px; flex-direction: row; align-items: center; }
.visit-box { flex-grow: 1; flex-shrink: 1; margin-right: 10px; padding: 10px 20px 14px 20px; background-image: resource("UI/Skins/panel_cream");
             -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.45px; }
.visit-name { font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); }
.root .visit-bar > .btn, .root .visit-bar > .btn:hover, .root .visit-bar > .btn:focus { width: 190px; }

/* ---- title screen ------------------------------------------------------------------------------------ */
.title { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; background-color: rgb(255, 236, 214); }
.title-logo { position: absolute; -unity-background-scale-mode: scale-to-fit; transform-origin: 50% 50%; }
.title-cat { position: absolute; -unity-background-scale-mode: scale-to-fit; transform-origin: 50% 100%; }
.title-tap { position: absolute; left: 0; right: 0; font-size: 40px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; -unity-text-align: middle-center;
             -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(120, 50, 60); text-shadow: 0 4px 0 rgba(120, 50, 60, 0.8); }
.title-status { position: absolute; left: 0; right: 0; font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(150, 90, 95); -unity-text-align: middle-center; }
.title-tap { left: 18%; right: 18%; height: 84px; padding-bottom: 8px; font-size: 36px; color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(190, 60, 105);
             text-shadow: 0 3px 0 rgba(170, 40, 85, 0.9); background-image: resource("UI/Skins/btn_pink");
             -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.6px; }
.title-status { color: rgb(130, 70, 80); }
/* stray in the rain */
.wb.stray { width: 74px; height: 74px; border-radius: 37px; background-color: rgb(236, 242, 255); border-width: 3px; border-bottom-width: 5px; border-color: rgb(130, 160, 220); }
.wb.stray .wb-ico { width: 52px; height: 52px; }

/* =====================================================================================================
   LANDSCAPE LAYOUT (panel reference 1646×760, match height)
   ===================================================================================================== */
.top { padding: 10px 16px 0 16px; }
/* tab rail on the left */
.tabs { left: 12px; right: auto; top: 96px; bottom: 12px; width: 128px; flex-direction: column; justify-content: space-around; padding: 12px 8px 18px 8px; }
.tab { width: 100%; height: auto; flex-grow: 1; flex-basis: 0; margin: 3px 0; }
.tab.on, .root .tab.on:hover, .root .tab.on:focus { translate: 8px 0; }
.tab-ico { width: 46px; height: 46px; }
.tab-lbl { font-size: 21px; }
.badge { right: 4px; top: 0; }
/* Cats / Photos panel slides in on the right */
.sheet { left: auto; right: 12px; top: 92px; bottom: 12px; width: 54%; max-height: none; padding: 18px 18px 18px 18px; border-width: 0;
         border-top-left-radius: 0; border-top-right-radius: 0; background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/panel_cream");
         -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.6px; }
.coach { left: 156px; right: 16px; top: 92px; }
.toast { top: 100px; left: 140px; }
/* popups */
.modal { width: 54%; max-height: 94%; padding: 22px 26px 26px 26px; }
.modal.catmodal { width: 88%; height: 94%; }
.catscroll { flex-grow: 1; flex-shrink: 1; align-self: stretch; margin-bottom: 10px; }
.catmodal > .row { flex-shrink: 0; }
.catmodal .cat-head { flex-shrink: 0; }
.catcols { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.catcol { width: 49.3%; }
.cat-head { margin-bottom: 8px; }
.modal.shop { width: 84%; height: 92%; margin-bottom: 0; }
.shop-tabs { flex-wrap: nowrap; }
.shop-tab, .root .shop-tab:hover, .root .shop-tab:focus { width: 16%; height: 66px; }
.scard { width: 23%; height: 300px; }
.modal .catgrid .catcard.small { width: 24%; height: 290px; }
.shard-list { max-height: 470px; }
.big-portrait { width: 170px; height: 170px; }
/* pages and bars */
.decor-bar { left: 156px; right: 16px; bottom: 16px; }
.spage { padding: 92px 18px 14px 156px; }
.rcard { left: 24%; right: 24%; bottom: 20px; }
.feed-pic { height: 400px; }
.vf-frame { left: 12%; right: 12%; top: 14%; bottom: 20%; }
.vf-top { top: 70px; }
.vf-bottom { bottom: 22px; }

/* ---- floating tools next to a piece (placing or selected) */
.float-tools { position: absolute; align-items: center; padding: 10px 18px 18px 18px; background-image: resource("UI/Skins/panel_cream");
               -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.45px; }
.float-name { font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); }
.float-hint { font-size: 18px; color: rgb(150, 115, 95); margin-bottom: 4px; }
.float-tools.placer { left: auto; right: 16px; top: 104px; width: 420px; }
.float-row { flex-direction: row; justify-content: center; margin-top: 4px; }
.rt { align-items: center; margin: 0 6px; width: 112px; }
.rt-btn { width: 86px; height: 88px; padding: 0 0 8px 0; margin: 0; border-width: 0; align-items: center; justify-content: center;
          background-color: rgba(0,0,0,0); -unity-background-scale-mode: stretch-to-fill; }
.root .rt-btn:hover, .root .rt-btn:focus { background-color: rgba(0,0,0,0); }
.root .rt-btn:active { scale: 0.92 0.92; }
.rt-mint, .root .rt-mint:hover, .root .rt-mint:focus { background-image: resource("UI/Skins/circ_mint"); }
.rt-cream, .root .rt-cream:hover, .root .rt-cream:focus { background-image: resource("UI/Skins/circ_cream"); }
.rt-pink, .root .rt-pink:hover, .root .rt-pink:focus { background-image: resource("UI/Skins/circ_pink"); }
.rt-gold, .root .rt-gold:hover, .root .rt-gold:focus { background-image: resource("UI/Skins/circ_gold"); }
.rt-ico { width: 44px; height: 44px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: white; }
.rt-cream .rt-ico { -unity-background-image-tint-color: rgb(140, 100, 75); }
.rt-lbl { width: 112px; font-size: 18px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(110, 72, 50); -unity-text-align: middle-center; white-space: nowrap; margin-top: 2px; }

/* =====================================================================================================
   STARTER GUIDE — glossy card + bouncing arrow + pulsing ring on the thing to tap
   ===================================================================================================== */
.guide-wrap { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.guide-card { position: absolute; flex-direction: row; align-items: center; width: 760px; height: 138px; padding: 12px 22px 18px 16px;
              background-image: resource("UI/Skins/panel_cream"); -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.45px;
              transform-origin: center; }
.guide-ava-ring { width: 104px; height: 104px; border-radius: 52px; background-color: rgb(255, 140, 178); border-width: 5px; border-color: white;
                  align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; margin-right: 18px; }
.guide-ava { width: 104px; height: 104px; -unity-background-scale-mode: scale-and-crop; margin-top: 14px; }
.guide-col { width: 540px; flex-shrink: 0; justify-content: center; }
.guide-head { flex-direction: row; align-items: center; height: 26px; }
.guide-step { font-size: 18px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(226, 88, 132); letter-spacing: 1px; margin-right: 12px; padding: 0; }
.guide-dots { flex-direction: row; align-items: center; }
.gdot { width: 12px; height: 12px; border-radius: 6px; margin-right: 6px; background-color: rgb(236, 214, 200); }
.gdot.on { background-color: rgb(255, 120, 165); }
.gdot.now { width: 28px; background-color: rgb(255, 120, 165); }
.guide-title { width: 540px; font-size: 34px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); white-space: nowrap; overflow: hidden; padding: 0; margin: 2px 0 0 0; }
.guide-sub { width: 540px; font-size: 24px; color: rgb(140, 105, 88); white-space: nowrap; overflow: hidden; padding: 0; margin: 2px 0 0 0; }
.guide-card.done .guide-ava-ring { background-color: rgb(255, 205, 90); }
.guide-card.done .guide-step { color: rgb(70, 170, 120); }
.root .guide-skip, .root .guide-skip:hover, .root .guide-skip:focus { position: absolute; right: 18px; top: 12px; height: 34px; padding: 0 14px; margin: 0;
              background-color: rgba(0,0,0,0); border-width: 0; font-size: 19px; color: rgb(175, 140, 120); -unity-font: resource("Fonts/Fredoka-SemiBold"); }
.guide-ptr { position: absolute; width: 96px; height: 96px; -unity-background-scale-mode: scale-to-fit; transform-origin: center; }
.guide-ring { position: absolute; -unity-background-scale-mode: stretch-to-fill; transform-origin: center; }
.guide-tag { position: absolute; height: 62px; padding: 0 26px 8px 26px; justify-content: center;
             background-image: resource("UI/Skins/btn_pink"); -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.42px; }
.guide-tag-txt { font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; white-space: nowrap; padding: 0;
                 -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(190, 60, 105); text-shadow: 0 2px 0 rgba(170, 40, 85, 0.9); }

/* ---- petting: friendship meter in the viewfinder, stroke hint, floating hearts */
.vf-bond { flex-direction: row; align-items: center; margin-top: 6px; padding: 6px 16px; border-radius: 22px; background-color: rgba(74, 51, 40, 0.78); transform-origin: center; }
.vf-bond-lbl { color: white; font-size: 20px; -unity-font: resource("Fonts/Fredoka-Bold"); margin-right: 10px; padding: 0; }
.vf-bond-hearts { flex-direction: row; margin-right: 10px; }
.vf-bheart { width: 26px; height: 26px; margin: 0 2px; -unity-background-scale-mode: scale-to-fit; }
.vf-bheart.off { opacity: 0.28; }
.vf-bond-bar { width: 110px; height: 12px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.25); overflow: hidden; }
.vf-bond-fill { height: 12px; border-radius: 6px; background-color: rgb(255, 128, 168); width: 0; }
.vf-hint { position: absolute; bottom: 140px; left: 0; right: 0; align-self: center; margin: 0 auto; flex-direction: row; align-items: center; justify-content: center; }
.vf-hint-ico { width: 34px; height: 34px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.vf-hint-txt { color: white; font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); padding: 6px 18px 10px 18px; border-radius: 24px; background-color: rgba(255, 128, 168, 0.95); }
.pet-heart { position: absolute; width: 60px; height: 60px; -unity-background-scale-mode: scale-to-fit; transform-origin: center; }

/* =====================================================================================================
   UI POLISH PASS — readable candy buttons, centred tab highlight, badges on the icon, clearer shelter controls
   ===================================================================================================== */
/* tab rail: selected highlight sits exactly in the middle of the rail */
.tabs .tab, .root .tabs .tab.on, .root .tabs .tab.on:hover, .root .tabs .tab.on:focus { translate: 0 0; margin-left: 0; margin-right: 0; }
.tabs .badge { right: 18px; top: 4px; }
/* white text on candy buttons gets a dark outline in the button's own colour, so it always reads */
.root .btn, .root .btn:hover, .root .btn:focus { -unity-text-outline-width: 1.4px; -unity-text-outline-color: rgb(176, 52, 98); text-shadow: 0 3px 0 rgba(160, 40, 85, 0.95); }
.root .btn.mint, .root .btn.mint:hover, .root .btn.mint:focus { -unity-text-outline-color: rgb(28, 128, 88); text-shadow: 0 3px 0 rgba(20, 110, 75, 0.95); }
.root .btn.gold, .root .btn.gold:hover, .root .btn.gold:focus { -unity-text-outline-color: rgb(182, 100, 0); text-shadow: 0 3px 0 rgba(165, 90, 0, 0.95); }
.root .btn.ghost, .root .btn.ghost:hover, .root .btn.ghost:focus, .root .btn.cream, .root .btn.cream:hover, .root .btn.cream:focus { -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0,0,0,0); }
.price-lbl { font-size: 28px; -unity-text-outline-width: 1.6px; -unity-text-outline-color: rgb(182, 100, 0); text-shadow: 0 3px 0 rgba(165, 90, 0, 0.95); }
.price.off { opacity: 1; -unity-background-image-tint-color: rgb(225, 215, 205); }
.price.off .price-lbl { -unity-text-outline-color: rgb(140, 125, 115); text-shadow: 0 2px 0 rgba(120, 105, 95, 0.9); }
.shop-tab.on .shop-tab-lbl { color: white; -unity-text-outline-width: 1.2px; -unity-text-outline-color: rgb(190, 70, 110); text-shadow: 0 2px 0 rgba(170, 50, 95, 0.9); }
/* shelter: big readable Adopt, a calm cream "why not" state instead of a faded button, captions under the round buttons */
.adopt-lbl { -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(182, 100, 0); text-shadow: 0 4px 0 rgba(165, 90, 0, 0.95); }
.adopt-num { font-size: 26px; color: white; -unity-text-outline-width: 1.2px; -unity-text-outline-color: rgb(170, 95, 0); }
.root .adopt.off, .root .adopt.off:hover, .root .adopt.off:focus { opacity: 1; background-image: resource("UI/Skins/btn_cream"); }
.adopt.off .adopt-lbl { color: rgb(160, 130, 110); -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0,0,0,0); }
.adopt-why { font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(214, 82, 122); margin-top: -2px; padding: 0; }
.scol { align-items: center; margin: 0 10px; }
.scol .sround { margin: 0; }
.scap { font-size: 20px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(110, 80, 60); margin-top: 4px; padding: 2px 12px 4px 12px; border-radius: 12px; background-color: rgba(255, 250, 243, 0.92); }
.sround-ico.big { width: 54px; height: 54px; }
.spage .shelter-why { font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); }
/* supplies: the label gives way, the buy button never overflows the card */
.supply-lbl { flex-shrink: 1; overflow: hidden; white-space: nowrap; }
.root .supply .btn.small { flex-shrink: 0; width: 140px; }
/* shard exchange list uses the whole window */
.shard-list { flex-grow: 1; flex-shrink: 1; max-height: none; }
.modal.catmodal > .row, .modal.catmodal > .modal-text { flex-shrink: 0; }
.toast.vf { top: 56%; }
.vf-hint { left: 50%; right: auto; translate: -50% 0; padding: 6px 20px 10px 14px; border-radius: 26px; background-color: rgba(255, 128, 168, 0.95); border-width: 3px; border-color: white; }
.vf-hint-ico { -unity-background-image-tint-color: white; }
.vf-hint-txt { background-color: rgba(0,0,0,0); padding: 0; }

/* =====================================================================================================
   GAME CORNER — picker tiles, who's-playing, game stage + HUD, results; photo request card stack
   ===================================================================================================== */
.arcade-modal .arc-sub { font-size: 22px; color: rgb(150, 115, 95); margin: 0 0 8px 6px; }
.gtiles { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; }
.root .gtile, .root .gtile:hover, .root .gtile:focus { width: 18.6%; height: 236px; margin: 0.7%; padding: 10px 6px 12px 6px; align-items: center;
    background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/panel_white"); border-width: 0;
    -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.45px; }
.root .gtile:active { scale: 0.95 0.95; }
.gtile-pic { width: 112px; height: 112px; border-radius: 56px; align-items: center; justify-content: center; border-width: 4px; border-color: white; }
.gtile-pic.big { width: 150px; height: 150px; border-radius: 75px; flex-shrink: 0; margin-right: 18px; }
.gtile-img { width: 78%; height: 78%; -unity-background-scale-mode: scale-to-fit; }
.gtile-name { width: 96%; font-size: 23px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); -unity-text-align: middle-center; white-space: nowrap; margin-top: 6px; padding: 0; }
.gtile-stars { flex-direction: row; justify-content: center; margin-top: 2px; }
.gstar { width: 26px; height: 26px; margin: 0 2px; -unity-background-scale-mode: scale-to-fit; }
.gstar.off { -unity-background-image-tint-color: rgba(120, 100, 90, 0.25); }
.gstar.small { width: 20px; height: 20px; margin: 0 1px; }
.gstar.big { width: 70px; height: 70px; margin: 0 8px; }
.gtile-best { font-size: 17px; color: rgb(150, 115, 95); -unity-text-align: middle-center; padding: 0; margin-top: 2px; }
.gtile.locked .gtile-pic { opacity: 0.45; }
.gtile .lockpill { position: absolute; top: 96px; }
.arc-pick { width: 62%; }
.arc-pick-top { flex-direction: row; align-items: center; align-self: stretch; }
.arc-pick-col { flex-grow: 1; flex-shrink: 1; }
.modal-title.left { -unity-text-align: middle-left; }
.arc-howto { font-size: 23px; color: rgb(110, 80, 60); white-space: normal; margin-bottom: 8px; }
.arc-goals { flex-direction: row; }
.arc-goal { flex-direction: row; align-items: center; margin-right: 16px; padding: 4px 12px; border-radius: 14px; background-color: rgb(255, 244, 214); }
.arc-goal-txt { font-size: 20px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(160, 110, 30); margin-left: 6px; padding: 0; }
.arc-note { font-size: 18px; color: rgb(170, 130, 110); margin-top: 6px; white-space: normal; }
.arc-who { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); margin: 14px 0 6px 0; align-self: flex-start; }
.arc-cats { flex-direction: row; flex-wrap: wrap; align-self: stretch; justify-content: flex-start; margin-bottom: 10px; }
.root .arc-cat, .root .arc-cat:hover, .root .arc-cat:focus { width: 120px; height: 150px; margin: 4px; padding: 6px 0; align-items: center; border-radius: 22px;
    background-color: rgb(255, 250, 243); border-width: 3px; border-color: rgba(214, 180, 150, 0.6); }
.root .arc-cat.on, .root .arc-cat.on:hover, .root .arc-cat.on:focus { background-color: rgb(255, 230, 238); border-color: rgb(255, 128, 168); translate: 0 -4px; }
.arc-cat-ring { width: 92px; height: 92px; border-radius: 46px; background-color: rgb(255, 224, 232); overflow: hidden; align-items: center; justify-content: center; }
.arc-cat-pic { width: 92px; height: 92px; -unity-background-scale-mode: scale-and-crop; margin-top: 10px; }
.arc-cat-name { width: 110px; font-size: 19px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); -unity-text-align: middle-center; margin-top: 4px; padding: 0; white-space: nowrap; overflow: hidden; }
.btn.big { height: 84px; min-width: 240px; font-size: 32px; }

/* the game itself */
.arc-bg { }
.arc-stage { overflow: hidden; }
.gspr, .gabs, .gbox { position: absolute; }
.gspr { -unity-background-scale-mode: scale-to-fit; }
.gimg { -unity-background-scale-mode: stretch-to-fill; }
.gcat { -unity-background-scale-mode: scale-to-fit; }
.soft { opacity: 0.9; }
.gpop { position: absolute; width: 400px; -unity-text-align: middle-center; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(90, 50, 40, 0.75); text-shadow: 0 3px 0 rgba(90, 50, 40, 0.5); padding: 0; }
.gchimney { border-left-width: 6px; border-right-width: 6px; border-color: rgb(186, 98, 80); }
.givy { border-left-width: 6px; border-right-width: 6px; border-color: rgb(96, 164, 98); }
.gchimney2 { background-color: rgb(196, 104, 86); border-radius: 6px; border-top-width: 10px; border-color: rgb(160, 80, 66); }
.grain { background-color: rgba(220, 235, 255, 0.55); border-radius: 3px; rotate: 8deg; }
.groof { border-bottom-width: 6px; border-color: rgb(176, 84, 72); }
.gwall { background-color: rgb(196, 170, 196); }
.gpaw { -unity-background-image-tint-color: rgb(255, 140, 175); }
.ghole { }
.gshelf { border-bottom-width: 8px; border-color: rgb(170, 112, 74); }
.gcushion { border-bottom-width: 8px; border-color: rgb(220, 110, 150); }
.gfinish { border-left-width: 4px; border-right-width: 4px; border-color: white; }
.glight { position: absolute; align-items: center; justify-content: center; border-width: 4px; border-color: white; }
.glight-txt { font-size: 40px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(60, 40, 40, 0.5); padding: 0; }
.gfloor { border-width: 6px; border-color: rgb(214, 180, 140); }
.gfield { border-width: 4px; border-color: rgb(214, 200, 250); }
.gcuprim { border-width: 4px; border-color: rgb(236, 226, 214); }
.gstart { border-width: 4px; border-color: white; }
.ghide-round { position: absolute; top: 108px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 28px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(90, 60, 40, 0.6); }
.gme { }

/* HUD */
.arc-hud { position: absolute; left: 14px; right: 14px; top: 12px; height: 84px; flex-direction: row; align-items: center; }
.arc-title { font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; margin: 0 16px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(90, 60, 50, 0.55); text-shadow: 0 3px 0 rgba(90, 60, 50, 0.4); flex-grow: 1; }
.arc-pill { flex-direction: row; align-items: center; height: 62px; padding: 0 20px 4px 14px; margin-left: 10px; border-radius: 31px; background-color: rgba(255, 252, 246, 0.95); border-width: 3px; border-bottom-width: 6px; border-color: rgba(214, 180, 150, 0.9); }
.arc-pill-ico { width: 38px; height: 38px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.arc-pill-val { font-size: 32px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); padding: 0; min-width: 60px; }
.arc-pill-lbl { font-size: 18px; color: rgb(150, 115, 95); margin-right: 8px; padding: 0; }
.arc-pill.time.low .arc-pill-val { color: rgb(230, 80, 90); }
.arc-lives { flex-direction: row; margin-left: 14px; padding: 8px 14px; border-radius: 28px; background-color: rgba(255, 252, 246, 0.95); }
.arc-heart { width: 40px; height: 40px; margin: 0 3px; -unity-background-scale-mode: scale-to-fit; }
.arc-heart.off { -unity-background-image-tint-color: rgba(120, 100, 90, 0.25); }
.arc-banner { position: absolute; left: 0; right: 0; top: 30%; -unity-text-align: middle-center; font-size: 72px; -unity-font: resource("Fonts/Fredoka-Bold"); -unity-text-outline-width: 3px; -unity-text-outline-color: rgba(80, 40, 40, 0.6); }
.arc-count { position: absolute; left: 0; right: 0; top: 30%; -unity-text-align: middle-center; font-size: 150px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(255, 110, 155); text-shadow: 0 8px 0 rgba(200, 60, 110, 0.6); }
.arc-how { position: absolute; left: 20%; right: 20%; top: 66%; -unity-text-align: middle-center; white-space: normal; font-size: 30px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44);
    background-color: rgba(255, 252, 246, 0.95); border-radius: 26px; padding: 14px 24px; border-width: 3px; border-color: rgba(255, 143, 171, 0.9); }
.arc-dim { background-color: rgba(60, 40, 40, 0.45); align-items: center; justify-content: center; }
.arc-result { width: 560px; align-items: center; padding: 26px 30px 30px 30px; background-image: resource("UI/Skins/panel_cream");
    -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.5px; }
.arc-big { font-size: 76px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(255, 120, 160); -unity-text-outline-width: 2px; -unity-text-outline-color: white; margin: 0; padding: 0; }
.arc-stars { flex-direction: row; margin: 4px 0 8px 0; }
.arc-best { font-size: 24px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; background-color: rgb(255, 120, 160); border-radius: 18px; padding: 4px 18px 6px 18px; margin-bottom: 8px; }
.arc-rewards { flex-direction: row; justify-content: center; margin-bottom: 10px; }
.arc-reward { flex-direction: row; align-items: center; margin: 0 10px; padding: 6px 16px; border-radius: 22px; background-color: rgb(255, 244, 222); }
.arc-reward-ico { width: 34px; height: 34px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.arc-reward-val { font-size: 26px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(150, 100, 40); padding: 0; }

/* photo request card stack (right edge) */
.reqstack { position: absolute; right: 14px; top: 100px; width: 330px; align-items: stretch; }
.req-cards { position: relative; }
.root .req-card, .root .req-card:hover, .root .req-card:focus { height: 92px; flex-direction: row; align-items: center; margin: 0 0 8px 0; padding: 8px 14px 12px 10px;
    background-color: rgba(0,0,0,0); background-image: resource("UI/Skins/panel_white"); border-width: 0;
    -unity-slice-left: 60; -unity-slice-right: 60; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.4px; }
.root .req-card:active { scale: 0.97 0.97; }
.req-card.peek { position: absolute; height: 92px; }
.req-pic { width: 62px; height: 62px; border-radius: 31px; background-color: rgb(255, 228, 236); -unity-background-scale-mode: scale-and-crop; border-width: 3px; border-color: rgb(255, 160, 190); flex-shrink: 0; margin-right: 10px; }
.req-pic.any { -unity-background-image-tint-color: rgb(255, 128, 168); -unity-background-scale-mode: scale-to-fit; }
.req-col { flex-grow: 1; flex-shrink: 1; }
.req-head { flex-direction: row; align-items: center; }
.req-cam { width: 20px; height: 20px; margin-right: 5px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 128, 168); }
.req-kicker { font-size: 16px; color: rgb(214, 82, 122); -unity-font: resource("Fonts/Fredoka-Bold"); padding: 0; }
.req-txt { width: 190px; font-size: 22px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(92, 60, 44); white-space: nowrap; padding: 0; margin: 1px 0 4px 0; }
.req-bar { height: 10px; border-radius: 5px; background-color: rgb(244, 232, 222); overflow: hidden; }
.req-fill { height: 10px; border-radius: 5px; background-color: rgb(127, 209, 174); }
.req-fill.low { background-color: rgb(255, 128, 140); }
.req-time { position: absolute; right: 14px; top: 10px; font-size: 17px; -unity-font: resource("Fonts/Fredoka-Bold"); color: rgb(170, 130, 110); padding: 0; }
.root .req-toggle, .root .req-toggle:hover, .root .req-toggle:focus { align-self: flex-end; height: 44px; padding: 0 18px 4px 18px; margin: 2px 6px 0 0; border-radius: 22px;
    background-color: rgba(74, 51, 40, 0.82); border-width: 0; }
.req-toggle-txt { font-size: 19px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; padding: 0; }

.glatte-round { position: absolute; bottom: 18px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 28px; -unity-font: resource("Fonts/Fredoka-Bold"); color: white; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(90, 60, 40, 0.6); }
.reqmark { scale: 0.75 0.75; }
.arc-row { flex-direction: row; justify-content: center; align-items: center; align-self: stretch; margin-top: 8px; flex-shrink: 0; }
.root .arc-btn, .root .arc-btn:hover, .root .arc-btn:focus { width: 230px; min-width: 230px; height: 80px; flex-shrink: 0; margin: 4px 10px; font-size: 30px; }
