/* Paw Café UI. Palette: cream #FFF8EE, ink #4A3328, pink #FF8FAB, mint #7FD1AE, gold #FFC94A, sky #9CC9F0 */
.root { flex-grow: 1; -unity-font: resource("Fonts/Fredoka"); color: rgb(74, 51, 40); }
.layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hidden { display: none; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.top { flex-direction: row; align-items: center; padding: 14px 14px 0 14px; }
.pill { flex-direction: row; align-items: center; background-color: rgb(255, 248, 238); border-radius: 28px; padding: 4px 16px 4px 4px; margin-right: 8px;
        border-bottom-width: 4px; border-color: rgba(150, 105, 70, 0.25); }
.pill-ico { width: 40px; height: 40px; border-radius: 20px; background-color: rgb(255, 225, 184); margin-right: 8px; -unity-background-scale-mode: scale-to-fit;
            -unity-text-align: middle-center; font-size: 22px; -unity-font-style: bold; color: rgb(197, 106, 42); }
.pill-val { font-size: 25px; -unity-font-style: bold; }
.lvl { width: 66px; height: 66px; border-radius: 33px; background-color: rgb(255, 143, 171); margin-right: 8px; align-items: center; justify-content: center;
       border-bottom-width: 4px; border-color: rgb(224, 104, 138); }
.lvl-num { color: white; font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; }
.lvl-bar { position: absolute; left: 6px; right: 6px; bottom: 6px; height: 6px; border-radius: 3px; background-color: rgba(255,255,255,0.35); }
.lvl-fill { height: 6px; border-radius: 3px; background-color: white; width: 0; }
.ibtn { width: 56px; height: 56px; border-radius: 28px; background-color: rgb(255, 248, 238); border-width: 0; border-bottom-width: 4px;
        border-color: rgba(150, 105, 70, 0.25); margin: 0 0 0 8px; padding: 10px; -unity-background-scale-mode: scale-to-fit; }

/* tabs */
.tabs { position: absolute; left: 10px; right: 10px; bottom: 12px; flex-direction: row; background-color: rgb(255, 248, 238); border-radius: 30px; padding: 8px;
        border-bottom-width: 5px; border-color: rgba(150, 105, 70, 0.25); }
.tab { flex-grow: 1; flex-basis: 0; height: 74px; border-radius: 22px; margin: 0 3px; align-items: center; justify-content: center; background-color: rgba(0,0,0,0);
       border-width: 0; padding: 0; }
.tab-ico { width: 36px; height: 36px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(150, 115, 95); }
.tab-lbl { font-size: 16px; color: rgb(150, 115, 95); margin-top: 2px; }
.tab.on { background-color: rgb(255, 143, 171); }
.tab.on .tab-lbl { color: white; -unity-font-style: bold; }
.tab.on .tab-ico { -unity-background-image-tint-color: white; }
.badge { position: absolute; right: 10px; top: 4px; min-width: 22px; height: 22px; border-radius: 11px; background-color: rgb(255, 99, 99); color: white;
         font-size: 14px; -unity-text-align: middle-center; padding: 0 5px; -unity-font-style: bold; }

/* sheets */
.sheet { position: absolute; left: 0; right: 0; bottom: 0; height: 62%; background-color: rgb(255, 248, 238); border-top-left-radius: 34px; border-top-right-radius: 34px;
         padding: 18px 18px 120px 18px; border-top-width: 4px; border-color: rgba(150, 105, 70, 0.18); }
.sheet-title { font-size: 30px; -unity-font-style: bold; margin-bottom: 8px; }
.sheet-sub { font-size: 17px; color: rgb(140, 110, 90); margin-bottom: 10px; white-space: normal; }
.chips { flex-direction: row; margin-bottom: 10px; flex-wrap: wrap; }
.chip { padding: 8px 16px; border-radius: 18px; background-color: white; margin: 0 8px 6px 0; font-size: 18px; border-width: 0; border-bottom-width: 3px; border-color: rgba(150,105,70,0.2); }
.chip.on { background-color: rgb(127, 209, 174); color: white; -unity-font-style: bold; }
.grid { flex-direction: row; flex-wrap: wrap; }
.card { width: 31%; margin: 0 1% 12px 1%; border-radius: 22px; background-color: white; align-items: center; padding: 10px 6px 12px 6px;
        border-bottom-width: 4px; border-color: rgba(150, 105, 70, 0.15); }
.card-img { width: 110px; height: 110px; -unity-background-scale-mode: scale-to-fit; border-radius: 16px; }
.card-name { font-size: 17px; -unity-text-align: middle-center; white-space: normal; -unity-font-style: bold; margin-top: 4px; }
.card-sub { font-size: 14px; -unity-text-align: middle-center; white-space: normal; color: rgb(140, 110, 90); }
.card.locked { opacity: 0.5; }
.btn { height: 54px; padding: 0 22px; border-radius: 20px; background-color: rgb(255, 143, 171); color: white; font-size: 21px; -unity-font-style: bold;
       border-width: 0; border-bottom-width: 5px; border-color: rgb(224, 104, 138); margin: 6px 4px; }
.btn.mint { background-color: rgb(127, 209, 174); border-color: rgb(79, 174, 137); }
.btn.gold { background-color: rgb(255, 201, 74); border-color: rgb(215, 160, 40); color: rgb(110, 70, 10); }
.btn.ghost { background-color: white; color: rgb(74, 51, 40); border-color: rgba(150,105,70,0.25); }
.btn.small { height: 42px; font-size: 17px; padding: 0 14px; border-radius: 16px; }
.btn:active { translate: 0 3px; border-bottom-width: 2px; }
.btn.off { opacity: 0.45; }
.listrow { flex-direction: row; align-items: center; background-color: white; border-radius: 20px; padding: 10px; margin-bottom: 10px;
           border-bottom-width: 4px; border-color: rgba(150,105,70,0.12); }
.portrait { width: 96px; height: 96px; border-radius: 48px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-to-fit; margin-right: 12px; }
.name { font-size: 22px; -unity-font-style: bold; }
.small { font-size: 15px; color: rgb(140, 110, 90); white-space: normal; }
.hearts { flex-direction: row; margin-top: 3px; }
.heart { width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit; margin-right: 2px; }
.photo { width: 31%; height: 180px; margin: 0 1% 12px 1%; border-radius: 14px; background-color: white; border-width: 6px; border-bottom-width: 22px; border-color: white;
         -unity-background-scale-mode: scale-and-crop; }

/* world bubbles */
.wb { position: absolute; width: 64px; height: 64px; border-radius: 32px; background-color: white; align-items: center; justify-content: center;
      border-bottom-width: 4px; border-color: rgba(150,105,70,0.25); translate: -50% -100%; }
.wb-ico { width: 38px; height: 38px; -unity-background-scale-mode: scale-to-fit; }
.wb-txt { font-size: 18px; -unity-font-style: bold; color: rgb(197, 106, 42); }
.wb-badge { display: none; }
/* photo request = a little polaroid of the wanted cat */
.wb.photo { background-color: white; width: auto; height: auto; min-width: 104px; border-radius: 10px; padding: 7px 7px 5px 7px;
            border-width: 3px; border-bottom-width: 5px; border-color: rgb(255, 143, 171); rotate: -3deg; }
.wb.photo .wb-ico { width: 88px; height: 88px; border-radius: 6px; background-color: rgb(255, 236, 222); -unity-background-scale-mode: scale-and-crop; }
.wb.photo.anycat .wb-ico { -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 143, 171); }
.wb.photo .wb-txt { font-size: 15px; color: rgb(214, 92, 128); margin-top: 3px; -unity-text-align: middle-center; }
.wb.photo .wb-badge { display: flex; position: absolute; right: -14px; top: -14px; width: 38px; height: 38px; border-radius: 19px;
            background-color: rgb(255, 143, 171); border-width: 3px; border-color: white; -unity-background-scale-mode: scale-to-fit;
            -unity-background-image-tint-color: white; }
.wb.coins { background-color: rgb(255, 230, 150); width: auto; padding: 0 14px; border-color: rgb(215,160,40); height: 50px; }
.wb.paw { background-color: rgb(156, 201, 240); border-color: rgb(110,160,210); }
.wb.paw .wb-ico { -unity-background-image-tint-color: white; }
.wb.lock { width: auto; padding: 0 14px; height: 48px; background-color: rgba(74,51,40,0.88); border-color: rgba(0,0,0,0.3); }
.wb.lock .wb-txt { color: white; font-size: 17px; }
.float { position: absolute; font-size: 30px; -unity-font-style: bold; color: rgb(255, 201, 74); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(140, 90, 20);
         translate: -50% -100%; }

/* toast / modal */
.toast { position: absolute; left: 0; right: 0; top: 120px; align-items: center; opacity: 0; transition-duration: 0.25s; transition-property: opacity, translate; translate: 0 -10px; }
.toast.on { opacity: 1; translate: 0 0; }
.toast-box { background-color: rgba(74, 51, 40, 0.92); border-radius: 18px; padding: 10px 20px; max-width: 90%; }
.toast-text { color: white; font-size: 20px; -unity-text-align: middle-center; white-space: normal; }
.scrim { background-color: rgba(40, 25, 20, 0.45); align-items: center; justify-content: center; }
.modal { width: 86%; background-color: rgb(255, 248, 238); border-radius: 32px; padding: 24px; align-items: center; border-bottom-width: 6px; border-color: rgba(150,105,70,0.25); }
.modal-title { font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; margin-bottom: 6px; }
.modal-text { font-size: 19px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 12px; color: rgb(110, 80, 60); }
.big-portrait { width: 220px; height: 220px; -unity-background-scale-mode: scale-to-fit; margin: 6px; }
.polaroid { width: 300px; height: 375px; background-color: white; border-width: 10px; border-bottom-width: 50px; border-color: white; -unity-background-scale-mode: scale-and-crop;
            rotate: -2deg; margin-bottom: 8px; }
.stars { flex-direction: row; justify-content: center; margin: 4px 0 8px 0; }
.star { width: 34px; height: 34px; -unity-background-scale-mode: scale-to-fit; margin: 0 3px; }
.star.off { -unity-background-image-tint-color: rgba(0,0,0,0.15); }
.step { flex-direction: row; align-items: center; width: 100%; background-color: white; border-radius: 18px; padding: 8px 12px; margin-bottom: 8px; }
.step-dot { width: 30px; height: 30px; border-radius: 15px; background-color: rgb(230, 220, 205); margin-right: 10px; color: white; -unity-text-align: middle-center; -unity-font-style: bold; }
.step.done .step-dot { background-color: rgb(127, 209, 174); }

/* viewfinder */
.vf { }
.vf-frame { position: absolute; left: 6%; right: 6%; top: 17%; bottom: 24%; border-width: 3px; border-color: rgba(255,255,255,0.85); border-radius: 28px; }
.vf-top { position: absolute; left: 0; right: 0; top: 96px; align-items: center; }
.vf-req { background-color: rgba(255, 143, 171, 0.95); border-radius: 18px; padding: 8px 16px; margin-bottom: 6px; }
.vf-req-pic { width: 46px; height: 46px; border-radius: 8px; background-color: white; margin-right: 10px; -unity-background-scale-mode: scale-and-crop; border-width: 2px; border-color: white; }
.vf-req-text { color: white; font-size: 19px; -unity-font-style: bold; -unity-text-align: middle-center; }
.vf-name { background-color: rgba(74,51,40,0.85); border-radius: 18px; padding: 6px 16px; color: white; font-size: 20px; }
.vf-bottom { position: absolute; left: 0; right: 0; bottom: 40px; flex-direction: row; justify-content: center; align-items: center; }
.shutter { width: 110px; height: 110px; border-radius: 55px; background-color: white; border-width: 8px; border-color: rgb(255, 143, 171); margin: 0 30px; }
.shutter:active { scale: 0.92 0.92; }
.flash { background-color: white; opacity: 0; transition-duration: 0.35s; transition-property: opacity; }
.flash.on { opacity: 0.9; transition-duration: 0s; }

.coach { position: absolute; left: 24px; right: 24px; bottom: 116px; align-items: center; }
.coach-box { flex-direction: row; align-items: center; background-color: rgb(255, 248, 238); border-radius: 22px; padding: 12px 18px; border-width: 3px; border-color: rgb(255, 170, 120); }
.coach-ico { width: 40px; height: 40px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.coach-text { color: rgb(74, 51, 40); font-size: 21px; white-space: normal; flex-shrink: 1; -unity-font-style: bold; }
